@model (string Icono, string Mensaje, string TituloBoton, string AccionBoton, string ControladorBoton, bool DeshabilitarBoton)

<div class="flex flex-col items-center justify-center p-12 bg-white rounded-xl border border-gray-200 border-dashed animate-fade-in text-center">
    <div class="text-5xl mb-4 text-gray-300">
        @(string.IsNullOrEmpty(Model.Icono) ? "📭" : Model.Icono)
    </div>
    <h3 class="text-lg font-medium text-gray-900 mb-2">No hay datos disponibles</h3>
    <p class="text-gray-500 max-w-sm mb-6">
        @Model.Mensaje
    </p>
    
    @if (!string.IsNullOrEmpty(Model.TituloBoton) && !string.IsNullOrEmpty(Model.AccionBoton))
    {
        if (Model.DeshabilitarBoton)
        {
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 bg-gray-300 text-gray-500 font-medium rounded-lg cursor-not-allowed">
                @Model.TituloBoton
            </button>
            <p class="text-xs text-red-500 mt-2">Acción bloqueada durante elección activa</p>
        }
        else
        {
            <a asp-controller="@Model.ControladorBoton" asp-action="@Model.AccionBoton" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                @Model.TituloBoton
            </a>
        }
    }
</div>
