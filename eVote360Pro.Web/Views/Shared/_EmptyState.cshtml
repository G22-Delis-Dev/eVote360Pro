@model (string IconoSvg, string Mensaje, string TituloBoton, string AccionBoton, string ControladorBoton, bool DeshabilitarBoton)

<div class="empty-state">
    <div class="empty-state-icon">
        @if (string.IsNullOrEmpty(Model.IconoSvg))
        {
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H6.911a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661z" />
            </svg>
        }
        else
        {
            @Html.Raw(Model.IconoSvg)
        }
    </div>
    <h3 class="empty-state-title">No hay datos disponibles</h3>
    <p class="empty-state-text">
        @Model.Mensaje
    </p>
    
    @if (!string.IsNullOrEmpty(Model.TituloBoton) && !string.IsNullOrEmpty(Model.AccionBoton))
    {
        if (Model.DeshabilitarBoton)
        {
            <div class="flex flex-col items-center">
                <button disabled class="btn btn-secondary disabled">
                    @Model.TituloBoton
                </button>
                <span class="form-error mt-2">Accion bloqueada durante eleccion activa</span>
            </div>
        }
        else
        {
            <a asp-controller="@Model.ControladorBoton" asp-action="@Model.AccionBoton" class="btn btn-primary">
                @Model.TituloBoton
            </a>
        }
    }
</div>
