<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dirigente | eVote360 Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dir: {
                            900: '#276749',
                            600: '#38a169',
                            200: '#c6f6d5'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-gray-800 flex h-screen overflow-hidden">

    <!-- Sidebar Dirigente -->
    <aside class="w-64 bg-dir-900 text-white flex flex-col hidden md:flex flex-shrink-0 transition-all duration-300 z-20">
        
        <!-- Logo Partido / Nombre -->
        <div class="h-24 flex flex-col items-center justify-center border-b border-dir-600 bg-dir-900 px-4">
            <!-- Si no hay ViewBag, un placeholder -->
            @if(ViewBag.LogoPartido != null) {
                <img src="@ViewBag.LogoPartido" alt="Logo" class="h-10 w-10 object-contain mb-1 rounded-full bg-white p-1" />
            } else {
                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center text-dir-900 font-bold mb-1">🏛️</div>
            }
            <span class="text-sm font-bold text-center truncate w-full">@(ViewBag.NombrePartido ?? "Mi Partido")</span>
        </div>
        
        <!-- Navegación -->
        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1 px-3">
                <li>
                    <a asp-controller="HomeDirigente" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-dir-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HomeDirigente" ? "bg-dir-600" : "")">
                        <span>🏠</span> Inicio
                    </a>
                </li>
                <li>
                    <a asp-controller="Candidatos" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-dir-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Candidatos" ? "bg-dir-600" : "")">
                        <span>👤</span> Mis Candidatos
                    </a>
                </li>
                <li>
                    <a asp-controller="Alianzas" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-dir-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Alianzas" ? "bg-dir-600" : "")">
                        <span>🤝</span> Alianzas Políticas
                    </a>
                </li>
                <li>
                    <a asp-controller="Asignaciones" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-dir-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Asignaciones" ? "bg-dir-600" : "")">
                        <span>📋</span> Asignar a Puestos
                    </a>
                </li>
            </ul>
        </nav>
        
        <!-- Info Dirigente -->
        <div class="p-4 border-t border-dir-600 bg-dir-900">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-dir-200 text-dir-900 flex items-center justify-center font-bold">
                    D
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">Dirigente</p>
                    <p class="text-xs text-dir-200 truncate">dirigente@partido.com</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Navbar Superior -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 z-10 shadow-sm">
            <button id="sidebarToggle" class="md:hidden text-gray-500 hover:text-gray-700 focus:outline-none">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            
            <div class="hidden md:block"></div>

            <div class="flex items-center gap-4 ml-auto">
                <a href="#" class="text-gray-500 hover:text-red-600 flex items-center gap-2 text-sm font-medium transition-colors">
                    <span>🚪</span> Cerrar Sesión
                </a>
            </div>
        </header>

        <partial name="_EleccionActivaBanner" />

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 animate-fade-in relative">
            <partial name="_Alert" />
            @RenderBody()
        </main>
    </div>

    <!-- Modal de Confirmación Global -->
    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', () => {
            const sidebar = document.querySelector('aside');
            if(sidebar.classList.contains('hidden')) {
                sidebar.classList.remove('hidden');
                sidebar.classList.add('absolute', 'h-full', 'shadow-2xl');
            } else {
                sidebar.classList.add('hidden');
                sidebar.classList.remove('absolute', 'h-full', 'shadow-2xl');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
