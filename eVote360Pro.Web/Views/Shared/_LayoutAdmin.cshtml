<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administrador | eVote360 Pro</title>
    <!-- Tailwind CSS CDN (Development) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        admin: {
                            900: '#1e3a5f',
                            600: '#2b6cb0',
                            200: '#bee3f8'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-gray-800 flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="w-64 bg-admin-900 text-white flex flex-col hidden md:flex flex-shrink-0 transition-all duration-300 z-20">
        <!-- Logo -->
        <div class="h-16 flex items-center px-6 border-b border-admin-600 bg-admin-900">
            <span class="text-xl font-bold flex items-center gap-2">
                <span class="text-2xl">🗳️</span> eVote360 Pro
            </span>
        </div>
        
        <!-- Navegación -->
        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1 px-3">
                <li>
                    <a asp-controller="HomeAdmin" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HomeAdmin" ? "bg-admin-600" : "")">
                        <span>🏠</span> Inicio
                    </a>
                </li>
                <li>
                    <a asp-controller="Ciudadanos" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ciudadanos" ? "bg-admin-600" : "")">
                        <span>👥</span> Ciudadanos
                    </a>
                </li>
                <li>
                    <a asp-controller="Usuarios" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "bg-admin-600" : "")">
                        <span>👤</span> Usuarios
                    </a>
                </li>
                <li>
                    <a asp-controller="Partidos" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Partidos" ? "bg-admin-600" : "")">
                        <span>🏛️</span> Partidos Políticos
                    </a>
                </li>
                <li>
                    <a asp-controller="PuestosElectivos" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PuestosElectivos" ? "bg-admin-600" : "")">
                        <span>📋</span> Puestos Electivos
                    </a>
                </li>
                <li>
                    <a asp-controller="AsignacionDirigentes" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AsignacionDirigentes" ? "bg-admin-600" : "")">
                        <span>🔗</span> Asignación Dirigentes
                    </a>
                </li>
                <li>
                    <a asp-controller="Elecciones" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-admin-600 transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Elecciones" ? "bg-admin-600" : "")">
                        <span>🗳️</span> Elecciones
                    </a>
                </li>
            </ul>
        </nav>
        
        <!-- Info Usuario inferior -->
        <div class="p-4 border-t border-admin-600 bg-admin-900">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-admin-200 text-admin-900 flex items-center justify-center font-bold">
                    A
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">Administrador</p>
                    <p class="text-xs text-admin-200 truncate">admin@evote.com</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Navbar Superior -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6 z-10 shadow-sm">
            <!-- Botón toggle móvil -->
            <button id="sidebarToggle" class="md:hidden text-gray-500 hover:text-gray-700 focus:outline-none">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            
            <div class="hidden md:block">
                <!-- Breadcrumbs placeholder -->
            </div>

            <!-- Acciones Header -->
            <div class="flex items-center gap-4 ml-auto">
                <a asp-controller="Auth" asp-action="Logout" class="text-gray-500 hover:text-red-600 flex items-center gap-2 text-sm font-medium transition-colors">
                    <span>🚪</span> Cerrar Sesión
                </a>
            </div>
        </header>

        <!-- Banner Elección Activa (se incluirá donde aplique, pero el layout puede inyectarlo si TempData/ViewBag lo indica) -->
        <partial name="_EleccionActivaBanner" />

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 animate-fade-in relative">
            <!-- Alertas globales -->
            <partial name="_Alert" />
            
            @RenderBody()
        </main>
    </div>

    <!-- Modal de Confirmación Global -->
    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Script para Toggle Sidebar en Móvil -->
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', () => {
            const sidebar = document.querySelector('aside');
            if(sidebar.classList.contains('hidden')) {
                sidebar.classList.remove('hidden');
                sidebar.classList.add('absolute', 'h-full', 'shadow-2xl');
            } else {
                sidebar.classList.add('hidden');
                sidebar.classList.remove('absolute', 'h-full', 'shadow-2xl');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
