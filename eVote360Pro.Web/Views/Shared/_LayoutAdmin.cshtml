<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administrador | eVote360 Pro</title>
    <!-- Tailwind CSS (Solo para utilidades base no cubiertas por nuestro CSS system) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {}
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex h-screen overflow-hidden bg-gray-100">

    <!-- Overlay para sidebar en móvil -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- Sidebar Administrador -->
    <aside id="sidebar" class="sidebar text-white shadow-xl flex-shrink-0 z-30" style="background-color: var(--admin-900);">
        <!-- Logo -->
        <div class="sidebar-header" style="background-color: var(--admin-900);">
            <a asp-controller="HomeAdmin" asp-action="Index" class="sidebar-logo text-white hover:text-white transition-none">
                <span class="icon" style="color: var(--admin-300);">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                </span>
                eVote360 Pro
            </a>
        </div>
        
        <!-- Navegación -->
        <nav class="sidebar-nav custom-scrollbar">
            <ul>
                <li class="nav-item">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HomeAdmin" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                        </span>
                        Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Ciudadanos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ciudadanos" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                            </svg>
                        </span>
                        Ciudadanos
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Usuarios" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                            </svg>
                        </span>
                        Usuarios
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Partidos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Partidos" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                            </svg>
                        </span>
                        Partidos Politicos
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="PuestosElectivos" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "PuestosElectivos" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75v-.008z" />
                            </svg>
                        </span>
                        Puestos Electivos
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AsignacionDirigentes" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AsignacionDirigentes" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                            </svg>
                        </span>
                        Asignación Dirigentes
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Elecciones" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Elecciones" ? "active" : "")">
                        <span class="icon icon-md">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                            </svg>
                        </span>
                        Elecciones
                    </a>
                </li>
            </ul>
        </nav>
        
        <!-- Info Usuario inferior -->
        <div class="sidebar-footer" style="background-color: var(--admin-900);">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar" style="background-color: var(--admin-100); color: var(--admin-900);">
                    A
                </div>
                <div class="sidebar-user-info">
                    <p class="sidebar-user-name">Administrador</p>
                    <p class="sidebar-user-role">admin@evote.com</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Contenido Principal -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
        <!-- Navbar Superior -->
        <header class="top-header">
            <!-- Botón toggle móvil -->
            <button id="sidebarToggle" class="header-toggle">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            
            <div class="hidden md:block">
                <!-- Breadcrumbs placeholder if needed globally -->
            </div>

            <!-- Acciones Header -->
            <div class="header-actions">
                <a asp-controller="Auth" asp-action="Logout" class="btn-logout group">
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                        </svg>
                    </span>
                    Cerrar Sesión
                </a>
            </div>
        </header>

        <!-- Banner Elección Activa -->
        <partial name="_EleccionActivaBanner" />

        <!-- Main Content Area -->
        <main class="main-content relative" id="mainContent">
            <!-- Alertas globales -->
            <partial name="_Alert" />
            
            @RenderBody()
        </main>
    </div>

    <!-- Modal de Confirmación Global -->
    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
