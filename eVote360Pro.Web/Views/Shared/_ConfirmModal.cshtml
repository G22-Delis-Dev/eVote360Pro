<!-- Modal de Confirmacion Generico -->
<div id="confirmModal" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-body">
            <div class="modal-icon modal-icon-danger">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h3 id="confirmModalTitle" class="modal-title">Confirmar Accion</h3>
            <p id="confirmModalMessage" class="modal-text">Esta seguro de que desea realizar esta accion?</p>
            
            <form id="confirmModalForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-actions">
                    <button type="button" onclick="closeConfirmModal()" class="btn btn-secondary">
                        Cancelar
                    </button>
                    <button id="confirmModalBtn" type="submit" class="btn btn-danger">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
