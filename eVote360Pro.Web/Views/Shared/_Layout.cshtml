@using eVote360Pro.Application.Interfaces
@inject ISesionUsuario sesionUsuario
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eVote360 Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-100 flex flex-col min-h-screen">
    <header class="bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-2 text-lg font-bold text-gray-900 no-underline">
                        <span class="icon text-admin-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                            </svg>
                        </span>
                        eVote360 Pro
                    </a>
                </div>
                <div class="flex items-center gap-4">
                    @{
                        var usuarioActual = sesionUsuario.ObtenerUsuarioSesion();
                    }
                    @if (usuarioActual != null)
                    {
                        <div class="flex items-center gap-3">
                            <div class="flex flex-col items-end">
                                <span class="text-sm font-medium text-gray-900">@usuarioActual.NombreUsuario</span>
                                <span class="text-xs text-gray-500">@usuarioActual.Rol</span>
                            </div>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                                <button type="submit" class="btn btn-outline btn-sm">Cerrar Sesion</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-sm">Acceder</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full animate-fade-in">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-sm text-gray-500">
            &copy; @DateTime.Now.Year - eVote360 Pro - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-admin-600 hover:text-admin-800">Privacidad</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
