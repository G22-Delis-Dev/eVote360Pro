@* Este banner verifica si hay una variable ViewBag o ViewData que indique elección activa.
   Opcionalmente, los ViewModels podrían tener esta propiedad y setear el ViewBag desde el Controller *@

@if (ViewBag.HayEleccionActiva == true || (Model?.GetType().GetProperty("HayEleccionActiva")?.GetValue(Model) as bool? == true))
{
    <div class="bg-yellow-400 w-full px-4 py-2 border-b-2 border-yellow-500 sticky top-0 z-10 shadow-sm animate-slide-in-up">
        <div class="max-w-7xl mx-auto flex items-center justify-center text-yellow-900 font-medium">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
            <span>⚠️ Elección activa — algunas acciones de modificación están bloqueadas para mantener la integridad de los datos.</span>
        </div>
    </div>
}
