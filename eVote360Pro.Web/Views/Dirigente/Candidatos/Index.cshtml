@model IEnumerable<eVote360Pro.Application.ViewModels.Candidatos.CandidatoListViewModel>

<h2>Mis Candidatos</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Registrar Nuevo Candidato</a>

<table class="table">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre Completo</th>
            <th>Puesto</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@item.FotoUrl" width="50" /></td>
                <td>@item.NombreCompleto</td>
                <td>@item.NombrePuesto</td>
                <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-info">Cambiar Estado</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>