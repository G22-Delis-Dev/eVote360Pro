@model eVote360Pro.Application.ViewModels.Home.HomeDirigenteViewModel
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Inicio Dirigente";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Panel de Control</h1>
        <ul class="breadcrumb">
            <li><span class="text-dir-600 font-medium">Inicio</span></li>
        </ul>
    </div>
</div>

<!-- Tarjetas de Resumen -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <div class="stat-card">
        <div class="stat-icon bg-green-50 text-green-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
        </div>
        <div>
            <p class="stat-label">Mis Candidatos</p>
            <p class="stat-value">@Model.TotalCandidatosPropios</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-blue-50 text-blue-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
            </svg>
        </div>
        <div>
            <p class="stat-label">Alianzas Activas</p>
            <p class="stat-value">@Model.TotalAlianzasActivas</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-yellow-50 text-yellow-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div>
            <p class="stat-label">Solicitudes Pendientes</p>
            <p class="stat-value">@Model.TotalSolicitudesPendientes</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-purple-50 text-purple-600">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
            </svg>
        </div>
        <div>
            <p class="stat-label">Asignaciones en Boleta</p>
            <p class="stat-value">@Model.TotalCandidatosAsignadosPuesto</p>
        </div>
    </div>

</div>

<!-- Acciones Rapidas y Bienvenida -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    
    <div class="card overflow-hidden flex flex-col justify-center p-8 text-center relative group">
        <!-- Decoracion de fondo SVG -->
        <div class="absolute -right-10 -top-10 opacity-5 group-hover:opacity-10 transition-opacity transform group-hover:scale-110 duration-500 text-dir-900">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="200" height="200">
                <path d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
            </svg>
        </div>
        
        <h2 class="text-2xl font-bold text-gray-900 mb-2 relative z-10">!Bienvenido al Panel Dirigente!</h2>
        <p class="text-gray-600 mb-6 relative z-10 max-w-md mx-auto">
            Desde aqui puedes gestionar los candidatos de tu partido, establecer alianzas politicas con otros partidos y asignar candidatos a los puestos electivos para la boleta de votacion.
        </p>
        <div class="relative z-10 flex justify-center gap-4">
            <a asp-controller="Candidatos" asp-action="Index" class="btn btn-primary-dir">
                Ver Candidatos
            </a>
            <a asp-controller="Alianzas" asp-action="Index" class="btn btn-outline bg-white">
                Ver Alianzas
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header border-b-0 pb-0">
            <h3 class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-dir-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
                Acciones Rapidas
            </h3>
        </div>
        <div class="card-body pt-4">
            <div class="space-y-3">
                <a asp-controller="Candidatos" asp-action="Create" class="quick-action">
                    <div class="quick-action-content">
                        <div class="quick-action-icon text-dir-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Registrar Nuevo Candidato</span>
                    </div>
                    <div class="quick-action-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </div>
                </a>
                
                <a asp-controller="Alianzas" asp-action="Create" class="quick-action">
                    <div class="quick-action-content">
                        <div class="quick-action-icon text-dir-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Proponer Alianza Politica</span>
                    </div>
                    <div class="quick-action-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </div>
                </a>

                <a asp-controller="Asignaciones" asp-action="Create" class="quick-action">
                    <div class="quick-action-content">
                        <div class="quick-action-icon text-dir-600">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Asignar Candidato a Puesto</span>
                    </div>
                    <div class="quick-action-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
