@{
    Layout = null;
    ViewData["Title"] = "Acceso Denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Denegado | eVote360 Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="access-denied-wrapper">

    <div class="access-denied-card animate-fade-in">
        <div class="access-denied-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
        </div>
        
        <h1 class="text-xl font-bold text-gray-900 mb-2">Acceso Denegado</h1>
        <p class="text-sm text-gray-600 mb-8">No tienes permisos para acceder a esta pagina. Verifica tu rol o contacta al administrador.</p>
        
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary w-full justify-center py-2.5">
            Volver al Inicio
        </a>
    </div>

</body>
</html>
