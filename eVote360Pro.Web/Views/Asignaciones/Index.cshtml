@model IEnumerable<eVote360Pro.Application.ViewModels.AsignacionCandidatos.AsignacionCandidatoListViewModel>
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Gestión de Candidaturas";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Candidaturas del Partido</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeDirigente" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Candidaturas (Asignaciones)</span></li>
        </ul>
    </div>
    
    <div class="flex items-center gap-3">
        @if (ViewBag.HayEleccionActiva == true)
        {
            <button disabled class="btn btn-secondary disabled" title="Accion bloqueada durante eleccion activa">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Asignar Candidato a Puesto
            </button>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary-dir">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Asignar Candidato a Puesto
            </a>
        }
    </div>
</div>

<div class="card mb-6">
    <div class="card-body p-4 bg-gray-50 border-b border-gray-200">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label class="form-label text-xs">Puesto Electivo</label>
                <select name="puestoIdFiltro" class="form-input py-2" onchange="this.form.submit()">
                    <option value="">Todos los puestos</option>
                    @foreach (var puesto in ViewBag.PuestosDisponibles as IEnumerable<SelectListItem> ?? [])
                    {
                        if (ViewBag.PuestoIdFiltro == int.Parse(puesto.Value))
                        {
                            <option value="@puesto.Value" selected>@puesto.Text</option>
                        }
                        else
                        {
                            <option value="@puesto.Value">@puesto.Text</option>
                        }
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-secondary py-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <partial name="_EmptyState" model="@(("<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' d='M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75v-.008z' /></svg>", "No tienes candidatos asignados a ningún puesto electivo.", "Asignar Candidato", "Create", "Asignaciones", (bool)(ViewBag.HayEleccionActiva ?? false)))" />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Puesto Electivo</th>
                        <th>Candidato (Ciudadano)</th>
                        <th>Fecha Asignacion</th>
                        <th class="cell-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cell-primary">@item.PuestoNombre</td>
                            <td>
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.FotoCandidato))
                                    {
                                        <div class="w-8 h-8 rounded-full border border-gray-200 bg-white overflow-hidden flex items-center justify-center">
                                            <img src="@item.FotoCandidato" alt="Foto" class="w-full h-full object-cover" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded-full border border-gray-200 bg-gray-50 flex items-center justify-center text-gray-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                            </svg>
                                        </div>
                                    }
                                    <span class="font-medium">@item.CandidatoNombreCompleto</span>
                                </div>
                            </td>
                            <td>@item.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                            <td class="cell-actions">
                                @if (ViewBag.HayEleccionActiva == true)
                                {
                                    <button disabled class="btn-action btn-action-disabled" title="Bloqueado por eleccion activa">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.152 0c-.34-.059-.68-.114-1.022-.165m0 0a48.11 48.11 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                        Retirar
                                    </button>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="showConfirmModal('Retirar Candidatura', '¿Estas seguro de retirar al candidato @item.CandidatoNombreCompleto del puesto @item.PuestoNombre?', '@Url.Action("Delete", "Asignaciones", new { id = item.Id })', 'btn-danger')"
                                            class="btn-action btn-action-danger">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.152 0c-.34-.059-.68-.114-1.022-.165m0 0a48.11 48.11 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                        Retirar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Paginacion" />
    }
</div>
