@model eVote360Pro.Application.ViewModels.Usuarios.UsuarioCreateViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Nuevo Usuario</h1>
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Usuarios</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Nuevo</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>👤</span> Información del Usuario
        </h2>
    </div>

    <form asp-action="Create" method="post" class="p-6">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nombres -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombres <span class="text-red-500">*</span></label>
                <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Apellidos -->
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellidos <span class="text-red-500">*</span></label>
                <input asp-for="Apellido" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="Apellido" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Nombre de Usuario -->
            <div>
                <label asp-for="NombreUsuario" class="block text-sm font-medium text-gray-700 mb-1">Usuario <span class="text-red-500">*</span></label>
                <input asp-for="NombreUsuario" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="NombreUsuario" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Correo -->
            <div>
                <label asp-for="CorreoElectronico" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico <span class="text-red-500">*</span></label>
                <input asp-for="CorreoElectronico" type="email" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="CorreoElectronico" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Contraseña -->
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Contraseña <span class="text-red-500">*</span></label>
                <div class="relative">
                    <input asp-for="Password" type="password" id="pwdInput" class="block w-full pr-10 px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                    <button type="button" onclick="togglePwd('pwdInput', 'eyeIcon')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none">
                        <span id="eyeIcon">👁️</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Rol -->
            <div>
                <label asp-for="Rol" class="block text-sm font-medium text-gray-700 mb-1">Rol <span class="text-red-500">*</span></label>
                <select asp-for="Rol" asp-items="Model.RolesDisponibles" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors">
                    <option value="">-- Seleccione un rol --</option>
                </select>
                <span asp-validation-for="Rol" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-admin-600 text-white font-medium rounded-lg hover:bg-admin-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-admin-500">
                Guardar Usuario
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = '🙈';
            } else {
                input.type = 'password';
                icon.textContent = '👁️';
            }
        }
    </script>
}
