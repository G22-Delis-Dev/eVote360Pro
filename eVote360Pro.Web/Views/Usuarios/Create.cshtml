@model eVote360Pro.Application.ViewModels.Usuarios.UsuarioCreateViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nuevo Usuario</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeAdmin" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><a asp-action="Index">Usuarios</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Nuevo</span></li>
        </ul>
    </div>
</div>

<div class="card max-w-3xl">
    <div class="card-header">
        <h2>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            Informacion del Usuario
        </h2>
    </div>

    <form asp-action="Create" method="post" class="card-body">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Seleccion de Ciudadano -->
            <div class="form-group md:col-span-2">
                <label asp-for="CiudadanoId" class="form-label">Ciudadano Asociado <span class="required">*</span></label>
                <select asp-for="CiudadanoId" asp-items="@(new SelectList(Model.CiudadanosDisponibles, "Id", "NombreCompletoDocumento"))" class="form-input">
                    <option value="">Seleccione un ciudadano (Solo ciudadanos sin usuario asignado)</option>
                </select>
                <span class="form-hint text-gray-500">Los datos personales (nombre, correo) se tomarán del ciudadano.</span>
                <span asp-validation-for="CiudadanoId" class="form-error"></span>
            </div>

            <!-- Nombre de Usuario -->
            <div class="form-group">
                <label asp-for="NombreUsuario" class="form-label">Nombre de Usuario <span class="required">*</span></label>
                <input asp-for="NombreUsuario" class="form-input form-input-mono text-sm" placeholder="ej. j.perez" />
                <span asp-validation-for="NombreUsuario" class="form-error"></span>
            </div>

            <!-- Contrasena -->
            <div class="form-group">
                <label asp-for="Password" class="form-label">Contrasena <span class="required">*</span></label>
                <div class="form-icon-wrapper">
                    <input asp-for="Password" type="password" id="createPassword" class="form-input" style="padding-right: 42px;" />
                    <span class="form-icon-right">
                        <button type="button" onclick="togglePasswordVisibility('createPassword', this)" class="btn-password-toggle">
                            <span class="icon-eye-open">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </span>
                            <span class="icon-eye-closed" style="display: none;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                </svg>
                            </span>
                        </button>
                    </span>
                </div>
                <span class="form-hint">Mínimo 6 caracteres.</span>
                <span asp-validation-for="Password" class="form-error"></span>
            </div>

            <!-- Rol -->
            <div class="form-group">
                <label asp-for="Rol" class="form-label">Rol del Sistema <span class="required">*</span></label>
                <select asp-for="Rol" class="form-input">
                    <option value="">Seleccione un rol</option>
                    <option value="Administrador">Administrador (Acceso Total)</option>
                    <option value="Dirigente">Dirigente (Gestion de Partidos/Candidatos)</option>
                    <!-- Elector se asigna automaticamente al crear ciudadano, no desde aqui por defecto -->
                </select>
                <span asp-validation-for="Rol" class="form-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
                Crear Usuario
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
