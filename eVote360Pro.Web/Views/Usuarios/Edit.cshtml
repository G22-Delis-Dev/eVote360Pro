@model eVote360Pro.Application.ViewModels.Usuarios.UsuarioEditViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Usuario";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Editar Usuario</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeAdmin" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><a asp-action="Index">Usuarios</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Editar</span></li>
        </ul>
    </div>
</div>

<div class="card max-w-3xl">
    <div class="card-header">
        <h2>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
            </svg>
            Modificar Usuario
        </h2>
    </div>

    <form asp-action="Edit" method="post" class="card-body">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Ciudadano (Solo lectura) -->
            <div class="form-group md:col-span-2">
                <label class="form-label">Ciudadano Asociado</label>
                <div class="form-input bg-gray-50 text-gray-500 flex items-center justify-between" style="border-color: var(--gray-200); cursor: not-allowed;">
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-600">
                            @Model.CiudadanoNombreCompleto.Substring(0, 1)
                        </div>
                        <span>@Model.CiudadanoNombreCompleto - @Model.CiudadanoDocumento</span>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-gray-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                </div>
            </div>

            <!-- Nombre de Usuario -->
            <div class="form-group">
                <label asp-for="NombreUsuario" class="form-label">Nombre de Usuario <span class="required">*</span></label>
                <input asp-for="NombreUsuario" class="form-input form-input-mono text-sm" />
                <span asp-validation-for="NombreUsuario" class="form-error"></span>
            </div>

            <!-- Rol -->
            <div class="form-group">
                <label asp-for="Rol" class="form-label">Rol del Sistema <span class="required">*</span></label>
                <select asp-for="Rol" asp-items="Model.RolesDisponibles" class="form-input">
                </select>
                <span asp-validation-for="Rol" class="form-error"></span>
            </div>

            <!-- Nueva Contrasena -->
            <div class="form-group md:col-span-2">
                <div class="p-4 bg-gray-50 rounded-md border border-gray-200 mt-4">
                    <h4 class="text-sm font-semibold text-gray-700 mb-2">Cambio de Contraseña (Opcional)</h4>
                    <p class="text-xs text-gray-500 mb-4">Solo llene este campo si desea cambiar la contraseña actual del usuario.</p>
                    
                    <label asp-for="NuevaPassword" class="form-label">Nueva Contraseña</label>
                    <div class="form-icon-wrapper max-w-md">
                        <input asp-for="NuevaPassword" type="password" id="editPassword" class="form-input" style="padding-right: 42px;" placeholder="Dejar en blanco para no cambiar" />
                        <span class="form-icon-right">
                            <button type="button" onclick="togglePasswordVisibility('editPassword', this)" class="btn-password-toggle">
                                <span class="icon-eye-open">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </span>
                                <span class="icon-eye-closed" style="display: none;">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                    </svg>
                                </span>
                            </button>
                        </span>
                    </div>
                    <span asp-validation-for="NuevaPassword" class="form-error"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
