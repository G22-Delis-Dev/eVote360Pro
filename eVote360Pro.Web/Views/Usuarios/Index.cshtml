@model eVote360Pro.Application.ViewModels.Usuarios.UsuarioListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Usuarios</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Usuarios</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-admin-600 hover:bg-admin-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <span>➕</span> Nuevo Usuario
        </a>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    @if (!Model.Usuarios.Any())
    {
        <partial name="_EmptyState" model="@(("👔", "No hay usuarios administrativos ni dirigentes registrados en el sistema. Haga clic en 'Nuevo Usuario' para registrar uno.", "Nuevo Usuario", "Create", "Usuarios", false))" />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Nombre</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Usuario</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Correo</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Rol</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Estado</th>
                        <th scope="col" class="px-6 py-3 font-semibold text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
                                @item.NombreCompleto
                            </td>
                            <td class="px-6 py-4">@item.NombreUsuario</td>
                            <td class="px-6 py-4">@item.CorreoElectronico</td>
                            <td class="px-6 py-4">
                                @if (item.Rol == "Administrador")
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-blue-100 text-blue-800">
                                        @item.Rol
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-purple-100 text-purple-800">
                                        @item.Rol
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Activo)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 transition-colors font-medium">✏️ Editar</a>
                                
                                @if (item.Rol == "Administrador" && Model.Usuarios.Count(u => u.Rol == "Administrador" && u.Activo) == 1 && item.Activo)
                                {
                                    <button disabled class="text-gray-300 cursor-not-allowed" title="No se puede desactivar al único administrador">❌ Desactivar</button>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="showConfirmModal('Cambiar Estado', '¿Estás seguro de que deseas @(item.Activo ? "desactivar" : "activar") al usuario @item.NombreUsuario?', '@Url.Action("ToggleActivo", "Usuarios", new { id = item.Id })', '@(item.Activo ? "bg-red-600 hover:bg-red-700" : "bg-green-600 hover:bg-green-700")')"
                                            class="@(item.Activo ? "text-red-600 hover:text-red-900" : "text-green-600 hover:text-green-900") transition-colors font-medium">
                                        @(item.Activo ? "❌ Desactivar" : "✅ Activar")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Paginacion" />
    }
</div>
