@model eVote360Pro.Application.ViewModels.Partidos.PartidoListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Partidos Políticos";
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 flex items-center gap-3 p-4 bg-red-50 border-l-4 border-red-500 rounded text-sm text-red-700" role="alert">
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Partidos Políticos</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Partidos</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div>
        @if (ViewBag.HayEleccionActiva == true)
        {
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" title="Acción bloqueada durante elección activa">
                <span>➕</span> Nuevo Partido
            </button>
        }
        else
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-admin-600 hover:bg-admin-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
                <span>➕</span> Nuevo Partido
            </a>
        }
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    @if (!Model.Partidos.Any())
    {
        <partial name="_EmptyState" model="@(("🏛️", "No hay partidos políticos registrados. Haga clic en 'Nuevo Partido' para registrar uno.", "Nuevo Partido", "Create", "Partidos", (bool)(ViewBag.HayEleccionActiva ?? false)))" />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Logo</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Nombre del Partido</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Siglas</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Estado</th>
                        <th scope="col" class="px-6 py-3 font-semibold text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Partidos)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(item.LogoUrl))
                                {
                                    <img src="@item.LogoUrl" alt="Logo @item.Nombre" class="w-12 h-12 object-contain rounded-full border border-gray-200 bg-white" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold border border-gray-300">
                                        @item.Siglas
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4 font-medium text-gray-900">
                                @item.Nombre
                            </td>
                            <td class="px-6 py-4 font-bold text-gray-700">
                                @item.Siglas
                            </td>
                            <td class="px-6 py-4">
                                @if (item.Activo)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                @if (ViewBag.HayEleccionActiva == true && item.EnEleccionActiva)
                                {
                                    <button disabled class="text-gray-400 cursor-not-allowed hover:text-gray-400" title="Bloqueado por participación en elección">✏️ Editar</button>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 transition-colors font-medium">✏️ Editar</a>
                                }
                                
                                @if (ViewBag.HayEleccionActiva == true && item.EnEleccionActiva)
                                {
                                    <button disabled class="text-gray-400 cursor-not-allowed hover:text-gray-400" title="Bloqueado por participación en elección">🔄 @(item.Activo ? "Desactivar" : "Activar")</button>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="showConfirmModal('Cambiar Estado', '¿Estás seguro de que deseas @(item.Activo ? "desactivar" : "activar") el partido @item.Nombre?', '@Url.Action("CambiarEstado", "Partidos", new { id = item.Id })', '@(item.Activo ? "bg-red-600 hover:bg-red-700" : "bg-green-600 hover:bg-green-700")')"
                                            class="@(item.Activo ? "text-red-600 hover:text-red-900" : "text-green-600 hover:text-green-900") transition-colors font-medium">
                                        @(item.Activo ? "❌ Desactivar" : "✅ Activar")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Paginacion" />
    }
</div>
