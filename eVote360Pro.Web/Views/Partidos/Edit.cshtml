@model eVote360Pro.Application.ViewModels.Partidos.PartidoEditViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Partido Político";
}

<div class="mb-6">
    <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900">Editar Partido Político</h1>
        @if (Model.Activo)
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Activo
            </span>
        }
        else
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                Inactivo
            </span>
        }
    </div>
    
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Partidos</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Editar</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>✏️</span> Modificar Información
        </h2>
    </div>

    <!-- enctype multipart/form-data para subir nuevo logo -->
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="p-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />
        <input type="hidden" asp-for="CamposCriticosEditables" />
        <input type="hidden" asp-for="LogoActual" />
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        @if (!Model.CamposCriticosEditables)
        {
            <div class="mb-6 bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded text-sm text-yellow-700 flex gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                <p>El Nombre y las Siglas no se pueden modificar porque este partido está participando en una elección activa.</p>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Logo Upload -->
            <div class="md:col-span-2 flex flex-col items-center justify-center mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2 w-full text-center">Logo del Partido</label>
                
                <div class="mt-4 hidden" id="previewContainer">
                    <p class="text-sm font-medium text-gray-700 mb-2">Nuevo logo seleccionado:</p>
                    <img id="logoPreview" src="#" alt="Preview" class="w-16 h-16 object-contain rounded-lg border-2 border-elec-200" />
                </div>
                            
                @if (!string.IsNullOrEmpty(Model.LogoActualRuta))
                {
                    <div class="mt-4" id="currentLogoContainer">
                        <p class="text-sm font-medium text-gray-700 mb-2">Logo actual:</p>
                        <img src="@Model.LogoActualRuta" alt="Logo actual" class="w-16 h-16 object-contain rounded-lg border-2 border-gray-200" />
                    </div>
                }
                
                <input asp-for="NuevoLogoArchivo" type="file" class="hidden" accept="image/jpeg,image/png,image/gif" onchange="previewImage(this);" />
                <span asp-validation-for="NuevoLogoArchivo" class="text-xs text-red-500 mt-1 block"></span>
                <p class="text-xs text-gray-500 mt-2 text-center">Dejar en blanco para conservar el logo actual.</p>
            </div>

            <!-- Nombre del Partido -->
            <div class="md:col-span-2">
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre Completo del Partido <span class="text-red-500">*</span></label>
                @if (Model.CamposCriticosEditables)
                {
                    <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                }
                else
                {
                    <input asp-for="Nombre" readonly class="block w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-gray-500 cursor-not-allowed" />
                }
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Siglas -->
            <div class="md:col-span-2">
                <label asp-for="Siglas" class="block text-sm font-medium text-gray-700 mb-1">Siglas <span class="text-red-500">*</span></label>
                @if (Model.CamposCriticosEditables)
                {
                    <input asp-for="Siglas" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors input-uppercase" />
                }
                else
                {
                    <input asp-for="Siglas" readonly class="block w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-gray-500 cursor-not-allowed" />
                }
                <span asp-validation-for="Siglas" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-admin-600 text-white font-medium rounded-lg hover:bg-admin-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-admin-500">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('logoPreview');
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    
                    var placeholder = document.getElementById('uploadPlaceholder');
                    if (placeholder) {
                        placeholder.classList.add('absolute', 'inset-0', 'bg-black', 'bg-opacity-50', 'flex', 'flex-col', 'items-center', 'justify-center', 'text-white', 'opacity-0', 'group-hover:opacity-100', 'transition-opacity');
                        placeholder.innerHTML = '<svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg><span class="text-xs font-medium">Cambiar</span>';
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
