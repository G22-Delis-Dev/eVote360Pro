@model eVote360Pro.Application.ViewModels.Candidatos.CandidatoCreateViewModel
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Nuevo Candidato";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Nuevo Candidato</h1>
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeDirigente" asp-action="Index" class="hover:text-dir-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-dir-600 md:ml-2">Candidatos</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Nuevo</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>👤</span> Información del Candidato
        </h2>
    </div>

    <!-- Se requiere enctype multipart/form-data para subir foto -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-6">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Foto Upload -->
            <div class="md:col-span-2 flex flex-col items-center justify-center mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2 w-full text-center">Foto del Candidato <span class="text-red-500">*</span></label>
                
                <div class="relative group cursor-pointer w-32 h-32 rounded-full border-2 border-dashed border-gray-300 hover:border-dir-500 flex items-center justify-center overflow-hidden bg-gray-50 transition-colors" onclick="document.getElementById('fotoInput').click()">
                    
                    <img id="fotoPreview" src="" class="absolute inset-0 w-full h-full object-cover hidden" />
                    
                    <div id="uploadPlaceholder" class="flex flex-col items-center justify-center text-gray-400 group-hover:text-dir-500">
                        <svg class="w-8 h-8 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <span class="text-xs font-medium">Subir Foto</span>
                    </div>
                </div>
                
                <input asp-for="FotoFile" type="file" id="fotoInput" class="hidden" accept="image/*" onchange="previewImage(this)" />
                <span asp-validation-for="FotoFile" class="text-xs text-red-500 mt-2 block text-center"></span>
                <p class="text-xs text-gray-500 mt-2 text-center">Formatos: JPG, PNG. Se recomienda imagen cuadrada de rostro.</p>
            </div>

            <!-- Nombres -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombres <span class="text-red-500">*</span></label>
                <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" placeholder="Ej. Juan Carlos" />
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Apellidos -->
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellidos <span class="text-red-500">*</span></label>
                <input asp-for="Apellido" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" placeholder="Ej. Pérez Gómez" />
                <span asp-validation-for="Apellido" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Documento -->
            <div class="md:col-span-2">
                <label asp-for="NumeroDocumento" class="block text-sm font-medium text-gray-700 mb-1">N° Documento (Cédula) <span class="text-red-500">*</span></label>
                <input asp-for="NumeroDocumento" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" placeholder="000-0000000-0" />
                <span asp-validation-for="NumeroDocumento" class="text-xs text-red-500 mt-1 block"></span>
                <p class="text-xs text-gray-500 mt-1">Debe ser un documento válido registrado en el padrón de ciudadanos.</p>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-dir-600 text-white font-medium rounded-lg hover:bg-dir-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-dir-500">
                Guardar Candidato
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('fotoPreview').src = e.target.result;
                    document.getElementById('fotoPreview').classList.remove('hidden');
                    document.getElementById('uploadPlaceholder').classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
