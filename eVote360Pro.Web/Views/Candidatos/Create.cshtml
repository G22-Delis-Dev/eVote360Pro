@model eVote360Pro.Application.ViewModels.Candidatos.CandidatoCreateViewModel
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Nuevo Candidato";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nuevo Candidato</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeDirigente" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><a asp-action="Index">Candidatos</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Nuevo</span></li>
        </ul>
    </div>
</div>

<div class="card max-w-3xl">
    <div class="card-header">
        <h2>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Registrar Candidato para el Partido
        </h2>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card-body">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Ciudadano -->
            <div class="form-group md:col-span-2">
                <label asp-for="CiudadanoId" class="form-label">Ciudadano (Candidato) <span class="required">*</span></label>
                <select asp-for="CiudadanoId" asp-items="@(new SelectList(Model.CiudadanosDisponibles, "Id", "NombreCompletoDocumento"))" class="form-input">
                    <option value="">Seleccione un ciudadano de la lista</option>
                </select>
                <span class="form-hint">Solo se muestran ciudadanos activos que no esten ya registrados como candidatos por su partido.</span>
                <span asp-validation-for="CiudadanoId" class="form-error"></span>
            </div>

            <!-- Foto -->
            <div class="form-group md:col-span-2">
                <label asp-for="FotoFile" class="form-label">Foto del Candidato (Opcional)</label>
                <input type="file" asp-for="FotoFile" class="form-input" accept="image/*" />
                <span class="form-hint">Formatos soportados: JPG, PNG. Esta foto aparecera en la boleta electoral.</span>
                <span asp-validation-for="FotoFile" class="form-error"></span>
            </div>
        </div>

        <div class="alert alert-info mt-6">
            <div class="alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
            </div>
            <div class="alert-text">
                Una vez registrado, debera <strong>Asignar al candidato a un puesto electivo</strong> en el modulo de Asignaciones para que aparezca en la boleta electoral.
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary-dir">
                Registrar Candidato
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
