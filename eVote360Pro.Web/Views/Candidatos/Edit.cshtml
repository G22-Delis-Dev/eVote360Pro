@model eVote360Pro.Application.ViewModels.Candidatos.CandidatoEditViewModel
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Editar Candidato";
}

<div class="mb-6">
    <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900">Editar Candidato</h1>
        @if (Model.Activo)
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Activo
            </span>
        }
        else
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                Inactivo
            </span>
        }
    </div>
    
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeDirigente" asp-action="Index" class="hover:text-dir-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-dir-600 md:ml-2">Candidatos</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Editar</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>✏️</span> Modificar Información
        </h2>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="p-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />
        <input type="hidden" asp-for="DocumentoEsEditable" />
        <input type="hidden" asp-for="FotoActual" />
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        @if (!Model.DocumentoEsEditable)
        {
            <div class="mb-6 bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded text-sm text-yellow-700 flex gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                <p>El N° de Documento no se puede modificar porque el candidato ya está asignado a un puesto en una elección activa o ya recibió votos.</p>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Foto Upload -->
            <div class="md:col-span-2 flex flex-col items-center justify-center mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2 w-full text-center">Foto del Candidato</label>
                
                <div class="relative group cursor-pointer w-32 h-32 rounded-full border-2 border-dashed border-gray-300 hover:border-dir-500 flex items-center justify-center overflow-hidden bg-white transition-colors" onclick="document.getElementById('fotoInput').click()">
                    
                    @if (!string.IsNullOrEmpty(Model.FotoActual))
                    {
                        <img id="fotoPreview" src="@Model.FotoActual" class="absolute inset-0 w-full h-full object-cover" />
                        <div id="uploadPlaceholder" class="absolute inset-0 bg-black bg-opacity-50 flex flex-col items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path></svg>
                            <span class="text-xs font-medium">Cambiar</span>
                        </div>
                    }
                    else
                    {
                        <img id="fotoPreview" src="" class="absolute inset-0 w-full h-full object-cover hidden" />
                        <div id="uploadPlaceholder" class="flex flex-col items-center justify-center text-gray-400 group-hover:text-dir-500">
                            <svg class="w-8 h-8 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path></svg>
                            <span class="text-xs font-medium">Subir Foto</span>
                        </div>
                    }
                </div>
                
                <input asp-for="NuevaFoto" type="file" id="fotoInput" class="hidden" onchange="previewImage(this)" />
                <span asp-validation-for="NuevaFoto" class="text-xs text-red-500 mt-2 block text-center"></span>
                <p class="text-xs text-gray-500 mt-2 text-center">Dejar en blanco para conservar la foto actual.</p>
            </div>

            <!-- Nombres -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombres <span class="text-red-500">*</span></label>
                <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" />
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Apellidos -->
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellidos <span class="text-red-500">*</span></label>
                <input asp-for="Apellido" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" />
                <span asp-validation-for="Apellido" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Documento -->
            <div class="md:col-span-2">
                <label asp-for="NumeroDocumento" class="block text-sm font-medium text-gray-700 mb-1">N° Documento <span class="text-red-500">*</span></label>
                @if (Model.DocumentoEsEditable)
                {
                    <input asp-for="NumeroDocumento" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-dir-500 focus:border-dir-500 transition-colors" />
                }
                else
                {
                    <input asp-for="NumeroDocumento" readonly class="block w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-gray-500 cursor-not-allowed" />
                }
                <span asp-validation-for="NumeroDocumento" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-dir-600 text-white font-medium rounded-lg hover:bg-dir-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-dir-500">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('fotoPreview');
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    
                    var placeholder = document.getElementById('uploadPlaceholder');
                    if (placeholder) {
                        placeholder.classList.add('absolute', 'inset-0', 'bg-black', 'bg-opacity-50', 'flex', 'flex-col', 'items-center', 'justify-center', 'text-white', 'opacity-0', 'group-hover:opacity-100', 'transition-opacity');
                        placeholder.innerHTML = '<svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path></svg><span class="text-xs font-medium">Cambiar</span>';
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
