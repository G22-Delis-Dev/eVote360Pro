@using eVote360Pro.Domain.Enums
@model IEnumerable<eVote360Pro.Application.ViewModels.Alianzas.AlianzaListViewModel>
@{
    Layout = "_LayoutDirigente";
    ViewData["Title"] = "Gestión de Alianzas";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Alianzas Políticas</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeDirigente" asp-action="Index" class="hover:text-dir-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Alianzas</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div>
        @if (ViewBag.HayEleccionActiva == true)
        {
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" title="Acción bloqueada durante elección activa">
                <span>🤝</span> Nueva Alianza
            </button>
        }
        else
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-dir-600 hover:bg-dir-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
                <span>🤝</span> Nueva Alianza
            </a>
        }
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8 p-6">
    @if (!Model.Any())
    {
        <div class="text-center py-8">
            <p class="text-gray-500">No hay alianzas registradas para este partido.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 rounded-t-lg">
                    <tr>
                        <th scope="col" class="px-6 py-3 rounded-tl-lg">Partido Solicitante</th>
                        <th scope="col" class="px-6 py-3">Partido Receptor</th>
                        <th scope="col" class="px-6 py-3">Estado</th>
                        <th scope="col" class="px-6 py-3">Fecha de Respuesta</th>
                        <th scope="col" class="px-6 py-3 rounded-tr-lg text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="bg-white border-b">
                            <td class="px-6 py-4 font-medium text-gray-900">@item.PartidoSolicitanteNombre</td>
                            <td class="px-6 py-4 font-medium text-gray-900">@item.PartidoReceptorNombre</td>
                            <td class="px-6 py-4">
                                @switch (item.Estado)
                                {
                                    case EstadoAlianza.Pendiente:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">Pendiente</span>
                                        break;
                                    case EstadoAlianza.Aceptada:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Aceptada</span>
                                        break;
                                    case EstadoAlianza.Rechazada:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Rechazada</span>
                                        break;
                                }
                            </td>
                            <td class="px-6 py-4">
                                @(item.FechaRespuesta?.ToString("dd/MM/yyyy") ?? "-")
                            </td>
                            <td class="px-6 py-4 text-right flex justify-end gap-2">
                                @if (ViewBag.HayEleccionActiva != true)
                                {
                                    @if (item.Estado == EstadoAlianza.Pendiente)
                                    {
                                        <!-- Si soy el receptor, puedo Aceptar o Rechazar -->
                                        @if (item.PartidoReceptorNombre != null && item.PartidoSolicitanteId != ViewBag.PartidoId)
                                        {
                                            <form asp-action="Responder" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="nuevoEstado" value="@EstadoAlianza.Aceptada" />
                                                <button type="submit" class="px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700">Aceptar</button>
                                            </form>
                                            <form asp-action="Responder" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="nuevoEstado" value="@EstadoAlianza.Rechazada" />
                                                <button type="submit" class="px-3 py-1 bg-red-100 text-red-700 text-xs rounded hover:bg-red-200">Rechazar</button>
                                            </form>
                                        }
                                        <!-- Si soy el solicitante, puedo Cancelar -->
                                        @if (item.PartidoSolicitanteId == ViewBag.PartidoId)
                                        {
                                            <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('¿Está seguro de cancelar esta solicitud?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="px-3 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700">Cancelar Solicitud</button>
                                            </form>
                                        }
                                    }
                                    else if (item.Estado == EstadoAlianza.Aceptada)
                                    {
                                        <!-- Cualquiera de los dos puede romper la alianza -->
                                        <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('¿Está seguro de romper esta alianza? Se verificará que no existan candidatos aliados.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="px-3 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700">Romper Alianza</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
