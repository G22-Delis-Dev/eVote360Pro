@model eVote360Pro.Application.ViewModels.Home.HomeAdminViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Inicio Administrador";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Panel de Control</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <span class="text-admin-600 font-medium">Inicio</span>
                </li>
            </ol>
        </nav>
    </div>
</div>

<!-- Tarjetas de Resumen General -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 mb-8">

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-2xl">👤</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Usuarios</p>
            <p class="text-2xl font-bold text-gray-900">@Model.TotalUsuarios</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center text-2xl">👥</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Ciudadanos</p>
            <p class="text-2xl font-bold text-gray-900">@Model.TotalCiudadanos</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center text-2xl">🏛️</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Partidos</p>
            <p class="text-2xl font-bold text-gray-900">@Model.TotalPartidosPoliticos</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-full bg-orange-50 text-orange-600 flex items-center justify-center text-2xl">📋</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Puestos Electivos</p>
            <p class="text-2xl font-bold text-gray-900">@Model.TotalPuestosElectivos</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl">🔗</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Asignaciones</p>
            <p class="text-2xl font-bold text-gray-900">@Model.TotalAsignacionesDirigentes</p>
        </div>
    </div>

</div>

<!-- Tarjetas de Elecciones -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">

    <div class="bg-white rounded-xl shadow-sm border border-yellow-200 p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-yellow-50 text-yellow-600 flex items-center justify-center text-2xl">🗳️</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Elección Activa</p>
            <p class="text-2xl font-bold text-yellow-600">@Model.EleccionesActivas</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-500 flex items-center justify-center text-2xl">⏳</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Pendientes</p>
            <p class="text-2xl font-bold text-gray-900">@Model.EleccionesPendientes</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-green-100 p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center text-2xl">✅</div>
        <div>
            <p class="text-sm font-medium text-gray-500">Finalizadas</p>
            <p class="text-2xl font-bold text-green-600">@Model.EleccionesFinalizadas</p>
        </div>
    </div>

</div>

<!-- Resumen Electoral por Año -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-gray-900">📊 Resumen Electoral — @Model.AnioConsulta</h2>
        <form asp-action="Index" method="get" class="flex items-center gap-2">
            <label class="text-sm text-gray-600 font-medium">Año:</label>
            <select name="anio" onchange="this.form.submit()"
                    class="border border-gray-300 text-sm rounded-lg px-3 py-1.5 focus:ring-admin-600 focus:border-admin-600">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    <option value="@y" selected="@(y == Model.AnioConsulta)">@y</option>
                }
            </select>
        </form>
    </div>

    @if (!Model.ResumenElecciones.Any())
    {
        <div class="p-8 text-center text-gray-500">
            <span class="text-3xl block mb-2">📭</span>
            <p>No hay elecciones registradas para el año @Model.AnioConsulta.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Elección</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Estado</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Partidos</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Candidatos</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Ciudadanos Votaron</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    @foreach (var item in Model.ResumenElecciones)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">@item.NombreEleccion</td>
                            <td class="px-6 py-4">
                                @switch (item.Estado)
                                {
                                    case "Activa":
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">Activa</span>
                                        break;
                                    case "Finalizada":
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Finalizada</span>
                                        break;
                                    default:
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">Pendiente</span>
                                        break;
                                }
                            </td>
                            <td class="px-6 py-4 text-center font-semibold text-purple-700">@item.TotalPartidos</td>
                            <td class="px-6 py-4 text-center font-semibold text-blue-700">@item.TotalCandidatos</td>
                            <td class="px-6 py-4 text-center font-semibold text-green-700">@item.TotalVotantes</td>
                            <td class="px-6 py-4 text-center">
                                @if (item.Estado == "Finalizada")
                                {
                                    <a asp-controller="Elecciones" asp-action="Resultados" asp-route-id="@item.Id"
                                       class="text-xs px-3 py-1.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                                        📊 Resultados
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Elecciones" asp-action="Index"
                                       class="text-xs px-3 py-1.5 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition-colors">
                                        Ver
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Acciones Rápidas -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900">Acciones Rápidas</h2>
    </div>
    <div class="p-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <a asp-controller="Elecciones" asp-action="Index"
           class="flex flex-col items-center justify-center p-4 border border-gray-200 rounded-lg hover:bg-admin-50 hover:border-admin-200 transition-colors group">
            <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">🗳️</span>
            <span class="text-sm font-medium text-gray-700 group-hover:text-admin-600">Gestionar Elecciones</span>
        </a>
        <a asp-controller="Ciudadanos" asp-action="Create"
           class="flex flex-col items-center justify-center p-4 border border-gray-200 rounded-lg hover:bg-admin-50 hover:border-admin-200 transition-colors group">
            <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">➕</span>
            <span class="text-sm font-medium text-gray-700 group-hover:text-admin-600">Nuevo Ciudadano</span>
        </a>
        <a asp-controller="Partidos" asp-action="Create"
           class="flex flex-col items-center justify-center p-4 border border-gray-200 rounded-lg hover:bg-admin-50 hover:border-admin-200 transition-colors group">
            <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">🏛️</span>
            <span class="text-sm font-medium text-gray-700 group-hover:text-admin-600">Nuevo Partido</span>
        </a>
        <a asp-controller="Usuarios" asp-action="Create"
           class="flex flex-col items-center justify-center p-4 border border-gray-200 rounded-lg hover:bg-admin-50 hover:border-admin-200 transition-colors group">
            <span class="text-3xl mb-2 group-hover:scale-110 transition-transform">👤</span>
            <span class="text-sm font-medium text-gray-700 group-hover:text-admin-600">Nuevo Usuario</span>
        </a>
    </div>
</div>
