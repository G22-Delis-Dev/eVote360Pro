@model eVote360Pro.Application.ViewModels.Elecciones.EleccionCreateViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nueva Elección";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nueva Elección</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeAdmin" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><a asp-action="Index">Elecciones</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Nueva</span></li>
        </ul>
    </div>
</div>

<div class="card max-w-2xl">
    <div class="card-header">
        <h2>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" />
            </svg>
            Planificar Proceso Electoral
        </h2>
    </div>

    <form asp-action="Create" method="post" class="card-body">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nombre -->
            <div class="form-group md:col-span-2">
                <label asp-for="Nombre" class="form-label">Nombre de la Elección <span class="required">*</span></label>
                <input asp-for="Nombre" class="form-input" placeholder="Ej. Elecciones Presidenciales 2024" />
                <span asp-validation-for="Nombre" class="form-error"></span>
            </div>

            <!-- Fecha -->
            <div class="form-group md:col-span-2">
                <label asp-for="FechaRealizacion" class="form-label">Fecha de Realización <span class="required">*</span></label>
                <input asp-for="FechaRealizacion" type="date" class="form-input md:max-w-xs" />
                <span class="form-hint">Seleccione la fecha pautada para las elecciones. El estado inicial será "Pendiente".</span>
                <span asp-validation-for="FechaRealizacion" class="form-error"></span>
            </div>
        </div>

        <div class="alert alert-info mt-6">
            <div class="alert-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
            </div>
            <div class="alert-text">
                Al crear una eleccion, los ciudadanos podran votar si la eleccion es iniciada (estado "Activa"). Recuerde que solo puede haber una eleccion activa a la vez.
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
                Guardar Elección
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
