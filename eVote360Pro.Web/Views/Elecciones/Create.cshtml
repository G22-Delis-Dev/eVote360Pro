@model eVote360Pro.Application.ViewModels.Elecciones.EleccionCreateViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nueva Elección";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Nueva Elección</h1>
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Elecciones</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Nueva</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-4xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>🗳️</span> Configuración de la Elección
        </h2>
    </div>

    <form asp-action="Create" method="post" class="p-6">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Datos Generales -->
            <div class="space-y-6">
                <div>
                    <h3 class="text-base font-medium text-gray-900 mb-4 border-b border-gray-200 pb-2">Datos Generales</h3>
                </div>

                <div>
                    <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre de la Elección <span class="text-red-500">*</span></label>
                    <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" placeholder="Ej. Elecciones Presidenciales 2024" />
                    <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="FechaEleccion" class="block text-sm font-medium text-gray-700 mb-1">Fecha de la Elección <span class="text-red-500">*</span></label>
                    <input asp-for="FechaEleccion" type="date" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                    <span asp-validation-for="FechaEleccion" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Puestos Electivos -->
            <div>
                <div>
                    <h3 class="text-base font-medium text-gray-900 mb-4 border-b border-gray-200 pb-2">Puestos a Disputa</h3>
                </div>

                @if (!Model.PuestosDisponibles.Any())
                {
                    <div class="bg-yellow-50 p-4 rounded text-sm text-yellow-700 flex gap-3">
                        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        <p>No hay puestos electivos activos registrados en el sistema. Debes crear al menos uno para poder configurar una elección.</p>
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 mb-3">Selecciona los puestos que estarán disponibles para esta elección:</p>
                    
                    <div class="space-y-3 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
                        @foreach (var puesto in Model.PuestosDisponibles)
                        {
                            <label class="flex items-start p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                                <div class="flex items-center h-5">
                                    <input type="checkbox" name="PuestosSeleccionadosIds" value="@puesto.Value" 
                                           @(Model.PuestosSeleccionadosIds.Contains(int.Parse(puesto.Value)) ? "checked" : "")
                                           class="w-4 h-4 text-admin-600 bg-gray-100 border-gray-300 rounded focus:ring-admin-500 focus:ring-2">
                                </div>
                                <div class="ml-3 text-sm">
                                    <span class="font-medium text-gray-900">@puesto.Text</span>
                                </div>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="PuestosSeleccionadosIds" class="text-xs text-red-500 mt-2 block"></span>
                }
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-admin-600 text-white font-medium rounded-lg hover:bg-admin-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-admin-500">
                Guardar Elección
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
