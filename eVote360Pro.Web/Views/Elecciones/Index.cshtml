@model eVote360Pro.Application.ViewModels.Elecciones.EleccionListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Elecciones";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Elecciones</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeAdmin" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Elecciones</span></li>
        </ul>
    </div>
    
    <div class="flex items-center gap-3">
        @if (ViewBag.HayEleccionActiva == true)
        {
            <button disabled class="btn btn-secondary disabled" title="Accion bloqueada durante eleccion activa">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nueva Eleccion
            </button>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nueva Eleccion
            </a>
        }
    </div>
</div>

<div class="card mb-6">
    <div class="card-body p-4 bg-gray-50 border-b border-gray-200">
        <form method="get" asp-action="Index" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label class="form-label text-xs">Ano Electoral</label>
                <select name="anio" class="form-input py-2" onchange="this.form.submit()">
                    <option value="">Todos los anos</option>
                    @for (int i = DateTime.Now.Year + 1; i >= DateTime.Now.Year - 10; i--)
                    {
                        if (Model.AnioFiltro == i.ToString())
                        {
                            <option value="@i" selected>@i</option>
                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                </select>
            </div>
            <div class="flex-1 w-full">
                <label class="form-label text-xs">Estado</label>
                <select name="estadoFiltro" class="form-input py-2" onchange="this.form.submit()">
                    <option value="">Todos los estados</option>
                    @if (Model.EstadoFiltro == "Pendiente") { <option value="Pendiente" selected>Pendiente</option> } else { <option value="Pendiente">Pendiente</option> }
                    @if (Model.EstadoFiltro == "Activa") { <option value="Activa" selected>Activa</option> } else { <option value="Activa">Activa</option> }
                    @if (Model.EstadoFiltro == "Finalizada") { <option value="Finalizada" selected>Finalizada</option> } else { <option value="Finalizada">Finalizada</option> }
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-secondary py-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
                    </svg>
                    Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Elecciones.Any())
    {
        <partial name="_EmptyState" model="@(("<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' d='M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z' /></svg>", "No hay elecciones registradas que coincidan con los filtros.", "Nueva Eleccion", "Create", "Elecciones", (bool)(ViewBag.HayEleccionActiva ?? false)))" />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Fecha de Realizacion</th>
                        <th>Estado</th>
                        <th class="cell-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Elecciones)
                    {
                        <tr>
                            <td class="cell-primary">@item.Nombre</td>
                            <td>@item.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (item.EstadoNombre)
                                {
                                    case "Activa":
                                        <span class="badge badge-warning">Activa</span>
                                        break;
                                    case "Finalizada":
                                        <span class="badge badge-success">Finalizada</span>
                                        break;
                                    default:
                                        <span class="badge badge-neutral">Pendiente</span>
                                        break;
                                }
                            </td>
                            <td class="cell-actions">
                                @if (item.EstadoNombre == "Pendiente")
                                {
                                    if (ViewBag.HayEleccionActiva == true)
                                    {
                                        <button disabled class="btn-action btn-action-disabled" title="Ya hay una eleccion activa">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                                            </svg>
                                            Iniciar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" 
                                                onclick="showConfirmModal('Iniciar Eleccion', '¿Esta seguro de iniciar esta eleccion? Una vez iniciada, no podra modificar ciudadanos, partidos ni puestos electivos.', '@Url.Action("Iniciar", "Elecciones", new { id = item.Id })', 'btn-success')"
                                                class="btn-action btn-action-success">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                                            </svg>
                                            Iniciar
                                        </button>
                                    }
                                }
                                else if (item.EstadoNombre == "Activa")
                                {
                                    <button type="button" 
                                            onclick="showConfirmModal('Finalizar Eleccion', '¿Esta seguro de finalizar esta eleccion? Una vez finalizada, ya no se podra votar y se podran ver los resultados finales.', '@Url.Action("Finalizar", "Elecciones", new { id = item.Id })', 'btn-danger')"
                                            class="btn-action btn-action-danger">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 7.5A2.25 2.25 0 017.5 5.25h9a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9z" />
                                        </svg>
                                        Finalizar
                                    </button>
                                }
                                else if (item.EstadoNombre == "Finalizada")
                                {
                                    <a asp-action="Resultados" asp-route-id="@item.Id" class="btn-action" style="color: var(--info);">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                                        </svg>
                                        Ver Resultados
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Paginacion" />
    }
</div>
