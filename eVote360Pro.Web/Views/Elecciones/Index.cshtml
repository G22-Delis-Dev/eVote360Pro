@using eVote360Pro.Domain.Enums
@model eVote360Pro.Application.ViewModels.Elecciones.EleccionListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Elecciones";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Elecciones</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Elecciones</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div>
        @if (Model.Elecciones.Any(e => e.Estado == EstadoEleccion.Activa))
        {
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" title="Ya existe una elección activa">
                <span>➕</span> Nueva Elección
            </button>
        }
        else
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-admin-600 hover:bg-admin-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
                <span>➕</span> Nueva Elección
            </a>
        }
    </div>
</div>

@if (!Model.Elecciones.Any())
{
    <partial name="_EmptyState" model="@(("🗳️", "No hay elecciones registradas en el sistema. Haga clic en 'Nueva Elección' para iniciar un proceso electoral.", "Nueva Elección", "Create", "Elecciones", false))" />
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var item in Model.Elecciones)
        {
            <div class="bg-white rounded-xl shadow-sm border @(item.Estado == EstadoEleccion.Activa ? "border-yellow-400 ring-1 ring-yellow-400" : "border-gray-200") overflow-hidden hover:shadow-md transition-shadow relative">
                
                @if (item.Estado == EstadoEleccion.Activa)
                {
                    <div class="absolute top-0 right-0 bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-bl-lg">
                        EN CURSO
                    </div>
                }

                <div class="p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-1">@item.Nombre</h3>
                            <p class="text-sm text-gray-500 flex items-center gap-1">
                                <span>📅</span> @item.FechaEleccion.ToString("dd 'de' MMMM, yyyy")
                            </p>
                        </div>
                    </div>

                    <div class="space-y-3 mb-6">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-500">Estado</span>
                            @switch (item.Estado)
                            {
                                case EstadoEleccion.Pendiente:
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        Pendiente
                                    </span>
                                    break;
                                case EstadoEleccion.Activa:
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                                        Activa
                                    </span>
                                    break;
                                case EstadoEleccion.Finalizada:
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Finalizada
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Puestos Electivos Badges -->
                    <div class="mb-6">
                        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Puestos en disputa</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var puesto in item.PuestosElectivos)
                            {
                                <span class="px-2 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded border border-blue-100">
                                    @puesto.Nombre
                                </span>
                            }
                        </div>
                    </div>

                    <div class="pt-4 border-t border-gray-100 flex flex-wrap gap-2 justify-end">
                        
                        @if (item.Estado == EstadoEleccion.Finalizada)
                        {
                            <a asp-action="Resultados" asp-route-id="@item.Id" class="flex-1 text-center px-3 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
                                📊 Ver Resultados
                            </a>
                        }
                        
                        @if (item.Estado == EstadoEleccion.Pendiente)
                        {
                            @if (!Model.Elecciones.Any(e => e.Estado == EstadoEleccion.Activa))
                            {
                                <button type="button" 
                                        onclick="showConfirmModal('Activar Elección', 'Al activar la elección, los ciudadanos podrán votar y se bloquearán las modificaciones en la plataforma. ¿Deseas continuar?', '@Url.Action("Activar", "Elecciones", new { id = item.Id })', 'bg-yellow-500 hover:bg-yellow-600')"
                                        class="flex-1 px-3 py-2 bg-yellow-500 text-white text-sm font-medium rounded-lg hover:bg-yellow-600 transition-colors">
                                    ▶️ Iniciar
                                </button>
                            }
                        }

                        @if (item.Estado == EstadoEleccion.Activa)
                        {
                            <button type="button" 
                                    onclick="showConfirmModal('Finalizar Elección', 'Esta acción cerrará la votación definitivamente y generará los resultados. No se puede deshacer. ¿Deseas finalizar la elección?', '@Url.Action("Finalizar", "Elecciones", new { id = item.Id })')"
                                    class="flex-1 px-3 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition-colors">
                                ⏹️ Finalizar
                            </button>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
}
