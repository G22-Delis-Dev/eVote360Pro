@model eVote360Pro.Application.ViewModels.Elecciones.EleccionResultadoViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Resultados de Elección";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Resultados Oficiales</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Elecciones</a>
                    </div>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Resultados</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div>
        <a asp-action="Index" class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 text-sm font-medium rounded-lg transition-colors">
            ⬅️ Volver
        </a>
    </div>
</div>

<!-- Tarjeta de Resumen -->
<div class="bg-gradient-to-r from-admin-900 to-admin-600 rounded-xl shadow-lg p-6 mb-8 text-white">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold mb-2">@Model.NombreEleccion</h2>
            <p class="text-admin-200 text-sm">Elección Finalizada</p>
        </div>
        <div class="flex gap-6">
            <div class="text-center bg-white/10 rounded-lg p-3 backdrop-blur-sm">
                <p class="text-admin-200 text-xs uppercase tracking-wider mb-1">Votos Emitidos</p>
                <p class="text-2xl font-bold">@Model.TotalVotosEmitidos.ToString("N0")</p>
            </div>
        </div>
    </div>
</div>

@if (!Model.ResultadosPorPuesto.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 text-center">
        <span class="text-4xl block mb-3">📊</span>
        <h3 class="text-lg font-medium text-gray-900 mb-1">Sin Resultados</h3>
        <p class="text-gray-500">No se registraron votos en esta elección o no hubo candidatos postulados.</p>
    </div>
}
else
{
    <!-- Iterar por cada Puesto -->
    foreach (var puesto in Model.ResultadosPorPuesto)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-xl font-bold text-gray-800">@puesto.NombrePuesto</h3>
                <span class="px-3 py-1 bg-white rounded-full text-xs font-semibold text-gray-600 border border-gray-200 shadow-sm">
                    Total Votos: @puesto.TotalVotosPuesto.ToString("N0")
                </span>
            </div>
            
            <div class="p-6">
                @if (!puesto.Candidatos.Any())
                {
                    <p class="text-gray-500 text-center py-4">No hubo candidatos para este puesto.</p>
                }
                else
                {
                    <div class="space-y-6">
                        @foreach (var candidato in puesto.Candidatos)
                        {
                            <div class="relative">
                                <!-- Tarjeta de Candidato -->
                                <div class="flex items-center gap-4 bg-white z-10 relative">
                                    <img src="@candidato.FotoCandidatoUrl" alt="@candidato.NombreCandidato" class="w-16 h-16 rounded-full object-cover border-2 border-gray-200 shadow-sm" />
                                    
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between mb-1">
                                            <div class="flex items-center gap-2">
                                                <h4 class="text-base font-bold text-gray-900 truncate">@candidato.NombreCandidato</h4>
                                                @if (candidato.EsGanador)
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-200" title="Ganador">
                                                        🏆 Ganador
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-right">
                                                <span class="text-lg font-bold text-gray-900">@candidato.PorcentajeVotos.ToString("0.0")%</span>
                                                <p class="text-xs text-gray-500">@candidato.VotosObtenidos.ToString("N0") votos</p>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center gap-2 mb-2">
                                            <img src="@candidato.LogoPartidoUrl" alt="@candidato.NombrePartido" class="w-5 h-5 object-contain" />
                                            <span class="text-xs text-gray-600">@candidato.NombrePartido</span>
                                            @if (candidato.EsAlianza)
                                            {
                                                <span class="text-xs text-blue-600 bg-blue-50 px-1.5 rounded" title="Postulado mediante alianza">🤝 Alianza</span>
                                            }
                                        </div>

                                        <!-- Barra de progreso -->
                                        <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                                            <div class="h-2.5 rounded-full transition-all duration-1000 @(candidato.EsGanador ? "bg-green-500" : "bg-blue-500")" 
                                                 style="width: 0%" 
                                                 data-target-width="@candidato.PorcentajeVotos.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Animar barras de progreso
            setTimeout(() => {
                const barras = document.querySelectorAll('[data-target-width]');
                barras.forEach(barra => {
                    barra.style.width = barra.getAttribute('data-target-width');
                });
            }, 300);
        });
    </script>
}
