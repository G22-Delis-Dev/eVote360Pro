@model eVote360Pro.Application.ViewModels.Elecciones.EleccionResultadoViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Resultados Electorales";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Resultados Electorales</h1>
        <ul class="breadcrumb">
            <li><a asp-controller="HomeAdmin" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><a asp-action="Index">Elecciones</a></li>
            <li class="breadcrumb-separator">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </li>
            <li><span>Resultados</span></li>
        </ul>
    </div>
    
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
            </svg>
            Volver
        </a>
    </div>
</div>

<div class="card mb-8">
    <div class="card-header bg-admin-900 text-white">
        <h2 class="text-white">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-admin-300">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
            @Model.NombreEleccion
        </h2>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="stat-card bg-gray-50 border-gray-200">
                <div class="stat-icon bg-blue-100 text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                    </svg>
                </div>
                <div>
                    <p class="stat-label">Total de Votantes</p>
                    <p class="stat-value">@Model.TotalVotosEmitidos</p>
                </div>
            </div>
            <div class="stat-card bg-gray-50 border-gray-200">
                <div class="stat-icon bg-green-100 text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="stat-label">Estado</p>
                    <p class="stat-value text-green-600">Finalizada</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.ResultadosPorPuesto.Any())
{
    <partial name="_EmptyState" model="@(("<svg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' d='M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z' /></svg>", "No hay resultados registrados (Ningun ciudadano voto).", "", "", "", false))" />
}
else
{
    @foreach (var puestoResult in Model.ResultadosPorPuesto)
    {
        <div class="card mb-6">
            <div class="card-header bg-gray-50">
                <h3 class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.315 48.315 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
                    </svg>
                    Puesto: @puestoResult.PuestoNombre
                </h3>
                <span class="badge badge-neutral">Votos totales: @puestoResult.TotalVotosPuesto</span>
            </div>
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Candidato</th>
                            <th>Partido Politico</th>
                            <th class="cell-center">Votos Obtenidos</th>
                            <th class="cell-center">Porcentaje</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Encontrar ganador (más votos)
                            var maxVotos = puestoResult.Candidatos.Any() ? puestoResult.Candidatos.Max(c => c.Votos) : 0;
                            var ganadores = puestoResult.Candidatos.Where(c => c.Votos == maxVotos && maxVotos > 0).ToList();
                        }

                        @foreach (var candidato in puestoResult.Candidatos.OrderByDescending(c => c.Votos))
                        {
                            bool isGanador = ganadores.Any(g => g.CandidatoId == candidato.CandidatoId);
                            
                            <tr class="@(isGanador ? "bg-green-50/50" : "")">
                                <td class="cell-primary font-bold">@candidato.CandidatoNombre</td>
                                <td>
                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(candidato.LogoPartido))
                                        {
                                            <div class="w-6 h-6 rounded border border-gray-200 bg-white p-0.5 overflow-hidden flex items-center justify-center">
                                                <img src="@candidato.LogoPartido" alt="Logo" class="max-w-full max-h-full object-contain" />
                                            </div>
                                        }
                                        <span>@candidato.PartidoNombre</span>
                                    </div>
                                </td>
                                <td class="cell-center text-lg font-bold" style="color: var(--admin-600);">@candidato.Votos</td>
                                <td class="cell-center font-medium">@candidato.Porcentaje.ToString("0.00")%</td>
                                <td>
                                    @if (isGanador)
                                    {
                                        <span class="badge badge-success flex items-center w-max">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3 mr-1">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" />
                                            </svg>
                                            Ganador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-gray-400">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body py-4 bg-gray-50 border-t border-gray-100">
                <!-- Barra de progreso visual para el porcentaje ganador -->
                @{
                    var topCandidato = puestoResult.Candidatos.OrderByDescending(c => c.Votos).FirstOrDefault();
                    if (topCandidato != null && topCandidato.Votos > 0)
                    {
                        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-1 mt-2">
                            <div class="bg-success h-2.5 rounded-full" style="width: @(topCandidato.Porcentaje.ToString("0.00").Replace(",", "."))%"></div>
                        </div>
                        <p class="text-xs text-gray-500 text-right">@topCandidato.Porcentaje.ToString("0.00")% del total de votos para este puesto</p>
                    }
                }
            </div>
        </div>
    }
}
