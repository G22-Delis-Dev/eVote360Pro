@model eVote360Pro.Application.ViewModels.Ciudadanos.CiudadanoCreateViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Nuevo Ciudadano";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Nuevo Ciudadano</h1>
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Ciudadanos</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Nuevo</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>📝</span> Información del Ciudadano
        </h2>
    </div>

    <form asp-action="Create" method="post" class="p-6">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nombres -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombres <span class="text-red-500">*</span></label>
                <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" placeholder="Ej. Juan Carlos" />
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Apellidos -->
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellidos <span class="text-red-500">*</span></label>
                <input asp-for="Apellido" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" placeholder="Ej. Pérez Gómez" />
                <span asp-validation-for="Apellido" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Documento -->
            <div>
                <label asp-for="NumeroDocumento" class="block text-sm font-medium text-gray-700 mb-1">N° Documento (Cédula) <span class="text-red-500">*</span></label>
                <input asp-for="NumeroDocumento" id="cedula-admin-create"
                       class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors font-mono"
                       placeholder="000-0000000-0" maxlength="13" />
                <span id="cedula-admin-create-hint" class="text-xs mt-1 block hidden"></span>
                <span asp-validation-for="NumeroDocumento" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Correo -->
            <div>
                <label asp-for="CorreoElectronico" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico <span class="text-red-500">*</span></label>
                <input asp-for="CorreoElectronico" type="email" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="CorreoElectronico" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-admin-600 text-white font-medium rounded-lg hover:bg-admin-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-admin-500">
                Guardar Ciudadano
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            iniciarFormatoCedula('cedula-admin-create', 'cedula-admin-create-hint');

            function iniciarFormatoCedula(inputId, hintId) {
                const input = document.getElementById(inputId);
                const hint  = document.getElementById(hintId);
                if (!input || !hint) return;

                input.addEventListener('input', function () {
                    this.value = this.value.replace(/[^\d-]/g, '');
                    hint.classList.add('hidden');
                });

                input.addEventListener('blur', function () {
                    const digits = this.value.replace(/\D/g, '');
                    if (digits.length === 0) { hint.classList.add('hidden'); return; }

                    if (digits.length < 11) {
                        hint.textContent = '⚠️ Cédula no completada (faltan ' + (11 - digits.length) + ' dígito(s))';
                        hint.className = 'text-xs mt-1 block text-amber-600 font-medium';
                        return;
                    }
                    if (digits.length > 11) {
                        hint.textContent = '⚠️ Cédula inválida (demasiados dígitos)';
                        hint.className = 'text-xs mt-1 block text-red-600 font-medium';
                        return;
                    }
                    this.value = digits.slice(0, 3) + '-' + digits.slice(3, 10) + '-' + digits.slice(10);
                    hint.textContent = '✅ Cédula válida';
                    hint.className = 'text-xs mt-1 block text-green-600 font-medium';
                });
            }
        })();
    </script>
}
