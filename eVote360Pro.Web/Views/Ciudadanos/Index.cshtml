@model eVote360Pro.Application.ViewModels.Ciudadanos.CiudadanoListViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gestión de Ciudadanos";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Ciudadanos</h1>
        <nav class="flex mt-1" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
                <li class="inline-flex items-center">
                    <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                        <span class="ml-1 text-gray-500 md:ml-2">Ciudadanos</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    
    <div class="flex items-center gap-3">
        <!-- Buscador -->
        <form method="get" asp-action="Index" class="relative">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg class="w-4 h-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                </svg>
            </div>
            <input type="text" name="filtro" value="@Model.Filtro" class="block w-full p-2 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-admin-500 focus:border-admin-500" placeholder="Buscar ciudadano...">
        </form>

        @if (ViewBag.HayEleccionActiva == true)
        {
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" title="Acción bloqueada durante elección activa">
                <span>➕</span> Nuevo Ciudadano
            </button>
        }
        else
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-admin-600 hover:bg-admin-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
                <span>➕</span> Nuevo Ciudadano
            </a>
        }
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    @if (!Model.Ciudadanos.Any())
    {
        <partial name="_EmptyState" model="@(("👥", "No hay ciudadanos registrados en el sistema. Haga clic en 'Nuevo Ciudadano' para registrar uno.", "Nuevo Ciudadano", "Create", "Ciudadanos", (bool)(ViewBag.HayEleccionActiva ?? false)))" />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Ciudadano</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Documento</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Correo</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Estado</th>
                        <th scope="col" class="px-6 py-3 font-semibold text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Ciudadanos)
                    {
                        <tr class="bg-white border-b hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-admin-100 text-admin-600 flex items-center justify-center font-bold text-xs">
                                    @item.NombreCompleto.Substring(0, 1)
                                </div>
                                @item.NombreCompleto
                            </td>
                            <td class="px-6 py-4">@item.NumeroDocumento</td>
                            <td class="px-6 py-4">@item.CorreoElectronico</td>
                            <td class="px-6 py-4">
                                @if (item.Activo)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                @if (ViewBag.HayEleccionActiva == true)
                                {
                                    <button disabled class="text-gray-400 cursor-not-allowed hover:text-gray-400" title="Bloqueado por elección activa">✏️ Editar</button>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 transition-colors font-medium">✏️ Editar</a>
                                }
                                
                                @if (ViewBag.HayEleccionActiva == true)
                                {
                                    <button disabled class="text-gray-400 cursor-not-allowed hover:text-gray-400" title="Bloqueado">🔄 @(item.Activo ? "Desactivar" : "Activar")</button>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="showConfirmModal('Cambiar Estado', '¿Estás seguro de que deseas @(item.Activo ? "desactivar" : "activar") al ciudadano @item.NombreCompleto?', '@Url.Action("CambiarEstado", "Ciudadanos", new { id = item.Id })', '@(item.Activo ? "bg-red-600 hover:bg-red-700" : "bg-green-600 hover:bg-green-700")')"
                                            class="@(item.Activo ? "text-red-600 hover:text-red-900" : "text-green-600 hover:text-green-900") transition-colors font-medium">
                                        @(item.Activo ? "❌ Desactivar" : "✅ Activar")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <partial name="_Paginacion" />
    }
</div>
