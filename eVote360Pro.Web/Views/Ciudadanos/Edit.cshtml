@model eVote360Pro.Application.ViewModels.Ciudadanos.CiudadanoEditViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Editar Ciudadano";
}

<div class="mb-6">
    <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900">Editar Ciudadano</h1>
        @if (Model.Activo)
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                Activo
            </span>
        }
        else
        {
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                Inactivo
            </span>
        }
    </div>
    
    <nav class="flex mt-1" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3 text-sm text-gray-500">
            <li class="inline-flex items-center">
                <a asp-controller="HomeAdmin" asp-action="Index" class="hover:text-admin-600">Inicio</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <a asp-action="Index" class="ml-1 hover:text-admin-600 md:ml-2">Ciudadanos</a>
                </div>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/></svg>
                    <span class="ml-1 text-gray-500 md:ml-2">Editar</span>
                </div>
            </li>
        </ol>
    </nav>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-3xl">
    <div class="border-b border-gray-100 bg-gray-50 px-6 py-4">
        <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <span>✏️</span> Modificar Información
        </h2>
    </div>

    <form asp-action="Edit" method="post" class="p-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />
        <input type="hidden" asp-for="DocumentoEsEditable" />
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        @if (!Model.DocumentoEsEditable)
        {
            <div class="mb-6 bg-blue-50 border-l-4 border-blue-500 p-4 rounded text-sm text-blue-700 flex gap-3">
                <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                <p>El N° de Documento no se puede modificar porque este ciudadano ya tiene participación registrada (ej. votación).</p>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nombres -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombres <span class="text-red-500">*</span></label>
                <input asp-for="Nombre" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="Nombre" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Apellidos -->
            <div>
                <label asp-for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellidos <span class="text-red-500">*</span></label>
                <input asp-for="Apellido" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="Apellido" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Documento -->
            <div>
                <label asp-for="NumeroDocumento" class="block text-sm font-medium text-gray-700 mb-1">N° Documento <span class="text-red-500">*</span></label>
                @if (Model.DocumentoEsEditable)
                {
                    <input asp-for="NumeroDocumento" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                }
                else
                {
                    <input asp-for="NumeroDocumento" readonly class="block w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-gray-500 cursor-not-allowed" />
                }
                <span asp-validation-for="NumeroDocumento" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Correo -->
            <div>
                <label asp-for="CorreoElectronico" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico <span class="text-red-500">*</span></label>
                <input asp-for="CorreoElectronico" type="email" class="block w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-admin-500 focus:border-admin-500 transition-colors" />
                <span asp-validation-for="CorreoElectronico" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
            <a asp-action="Index" class="px-4 py-2 text-gray-700 bg-gray-100 font-medium rounded-lg hover:bg-gray-200 transition-colors">
                Cancelar
            </a>
            <button type="submit" class="px-4 py-2 bg-admin-600 text-white font-medium rounded-lg hover:bg-admin-700 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-admin-500">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
