@model eVote360Pro.Application.ViewModels.Votacion.ValidacionIdentidadViewModel
@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Validar Identidad";
    ViewData["PasoActivo"] = 2;
}

<div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 max-w-xl mx-auto w-full">
    <div class="p-8 text-center border-b border-gray-100">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-elec-100 text-elec-600 mb-4 text-3xl">
            🆔
        </div>
        <h2 class="text-2xl font-bold text-gray-900">Validación de Identidad</h2>
        <p class="text-gray-500 mt-2">Para comenzar, necesitamos verificar que estás registrado en el padrón electoral.</p>
    </div>

    <form asp-action="ValidarIdentidad" method="post" class="p-8">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="mb-6 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-200"></div>

        <div class="mb-8">
            <label asp-for="NumeroDocumento" class="block text-sm font-bold text-gray-700 mb-2">Número de Documento (Cédula)</label>
            <input asp-for="NumeroDocumento" class="block w-full px-4 py-3 text-lg border border-gray-300 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-elec-500 focus:border-elec-500 transition-colors text-center font-mono tracking-widest" placeholder="000-0000000-0" autocomplete="off" />
            <span asp-validation-for="NumeroDocumento" class="text-xs text-red-500 mt-2 block text-center"></span>
        </div>

        <div class="flex justify-between items-center pt-4">
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700 font-medium text-sm transition-colors flex items-center gap-1">
                ⬅️ Atrás
            </a>
            <button type="submit" class="px-6 py-3 bg-elec-600 text-white font-bold rounded-xl hover:bg-elec-900 transition-colors shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-elec-500 flex items-center gap-2">
                Continuar ➡️
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
