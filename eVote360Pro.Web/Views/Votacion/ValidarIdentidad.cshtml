@model eVote360Pro.Application.ViewModels.Votacion.ValidacionIdentidadViewModel
@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Validar Identidad";
}

<div class="max-w-md mx-auto pt-10 pb-20">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Validación de Identidad</h1>
        <p class="text-gray-500 mt-2">Paso 1: Verificación de Documento</p>
    </div>

    <div class="card p-8 shadow-lg">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 bg-primary-50 rounded-full flex items-center justify-center text-primary border border-primary-100">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z" />
                </svg>
            </div>
        </div>

        <form asp-action="ValidarIdentidad" method="post" id="formValidarIdentidad">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="form-validation-summary mb-4"></div>

            <div class="form-group mb-6">
                <label asp-for="NumeroDocumento" class="form-label text-center block">Ingresa tu Numero de Cedula</label>
                <input asp-for="NumeroDocumento" id="cedulaElector" class="form-input form-input-mono text-center text-xl tracking-widest py-3" placeholder="000-0000000-0" maxlength="13" autofocus />
                <span id="cedulaHint" class="form-hint text-center block mt-2" style="display: none;"></span>
                <span asp-validation-for="NumeroDocumento" class="form-error text-center block mt-1"></span>
            </div>

            <button type="submit" id="btnContinuar" class="btn btn-primary w-full py-3 justify-center text-lg" disabled>
                Continuar
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 ml-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </button>
        </form>
    </div>

    <div class="mt-8 text-center text-sm text-gray-500">
        <p>Al continuar, se enviará un código de verificación a tu correo electrónico registrado.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('cedulaElector');
            const hint = document.getElementById('cedulaHint');
            const btn = document.getElementById('btnContinuar');

            input.addEventListener('input', function () {
                let val = this.value.replace(/[^\d-]/g, '');
                this.value = val;
                
                const digits = val.replace(/\D/g, '');
                
                if (digits.length === 11) {
                    this.value = digits.slice(0, 3) + '-' + digits.slice(3, 10) + '-' + digits.slice(10);
                    btn.disabled = false;
                    hint.style.display = 'none';
                } else {
                    btn.disabled = true;
                    if (digits.length > 0) {
                        hint.style.display = 'block';
                        hint.textContent = `Faltan ${11 - digits.length} digitos`;
                        hint.className = 'form-hint text-center block mt-2 text-warning';
                    } else {
                        hint.style.display = 'none';
                    }
                }
            });
        });
    </script>
}
