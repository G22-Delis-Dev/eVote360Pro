@model eVote360Pro.Application.ViewModels.Votacion.BoletaElectoralViewModel
@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Boleta Electoral";
    ViewData["PasoActivo"] = 4;
}

<div class="mb-8">
    <div class="bg-gradient-to-r from-elec-900 to-elec-600 rounded-2xl shadow-lg p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold mb-1">Boleta Electoral</h1>
            <p class="text-elec-100 text-sm sm:text-base">Selecciona un candidato por cada puesto disponible.</p>
        </div>
        <div class="bg-white/10 p-3 rounded-lg backdrop-blur-sm border border-white/20 text-center min-w-[120px]">
            <p class="text-xs text-elec-200 uppercase tracking-wider mb-1">Tu progreso</p>
            <p class="text-2xl font-bold"><span id="puestosSeleccionados">0</span> / @Model.Puestos.Count</p>
        </div>
    </div>
</div>

<form asp-action="ConfirmarVoto" method="post" id="boletaForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VotanteId" />
    <input type="hidden" asp-for="TokenAutenticacion" />
    <input type="hidden" asp-for="EleccionId" />

    <div class="space-y-12 mb-12">
        @for (int i = 0; i < Model.Puestos.Count; i++)
        {
            var puesto = Model.Puestos[i];
            
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden puesto-container" data-puesto-index="@i">
                <!-- Header del Puesto -->
                <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex items-center justify-between sticky top-0 z-10">
                    <h2 class="text-xl font-bold text-gray-900">@puesto.PuestoNombre</h2>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-700 status-badge">
                        <span class="w-2 h-2 rounded-full bg-gray-400 indicator-dot"></span>
                        Pendiente
                    </span>
                </div>
                
                <input type="hidden" asp-for="Puestos[i].PuestoId" />
                <input type="hidden" asp-for="Puestos[i].PuestoNombre" />
                
                <!-- Opciones de Candidatos -->
                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        
                        <!-- Opción: Ninguno (Voto en Blanco) -->
                        <label class="relative cursor-pointer group">
                            <input type="radio" asp-for="Puestos[i].CandidatoSeleccionadoId" value="" class="peer sr-only candidato-radio" onchange="actualizarProgreso()" />
                            <div class="h-full bg-white border-2 border-gray-200 rounded-xl p-4 hover:border-elec-300 hover:bg-elec-50 transition-all peer-checked:border-elec-600 peer-checked:bg-elec-50 peer-checked:shadow-md flex flex-col items-center justify-center text-center min-h-[160px]">
                                <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-3 text-2xl group-hover:bg-white group-hover:text-elec-500 peer-checked:bg-white peer-checked:text-elec-600 transition-colors">
                                    ⚪
                                </div>
                                <span class="font-bold text-gray-700 peer-checked:text-elec-900">Voto en Blanco</span>
                                <span class="text-xs text-gray-500 mt-1">No seleccionar a nadie</span>
                                
                                <div class="absolute top-3 right-3 w-5 h-5 rounded-full border-2 border-gray-300 bg-white peer-checked:border-elec-600 peer-checked:bg-elec-600 flex items-center justify-center transition-colors">
                                    <svg class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                </div>
                            </div>
                        </label>

                        <!-- Iterar Candidatos -->
                        @foreach (var candidato in puesto.Candidatos)
                        {
                            <label class="relative cursor-pointer group">
                                <input type="radio" asp-for="Puestos[i].CandidatoSeleccionadoId" value="@candidato.CandidatoId" class="peer sr-only candidato-radio" onchange="actualizarProgreso()" />
                                <div class="h-full bg-white border-2 border-gray-200 rounded-xl p-4 hover:border-elec-300 hover:bg-elec-50 transition-all peer-checked:border-elec-600 peer-checked:bg-elec-50 peer-checked:shadow-md flex flex-col items-center text-center">
                                    
                                    @if (!string.IsNullOrEmpty(candidato.FotoCandidatoUrl))
                                    {
                                        <img src="@candidato.FotoCandidatoUrl" alt="@candidato.CandidatoNombre" class="w-20 h-20 rounded-full object-cover border-4 border-white shadow-sm mb-3 group-hover:border-elec-100 peer-checked:border-elec-200 transition-colors" />
                                    }
                                    else
                                    {
                                        <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 border-4 border-white shadow-sm mb-3 text-2xl font-bold group-hover:border-elec-100 peer-checked:border-elec-200 peer-checked:bg-white peer-checked:text-elec-600 transition-colors">
                                            👤
                                        </div>
                                    }
                                    
                                    <span class="font-bold text-gray-900 peer-checked:text-elec-900 leading-tight mb-2">@candidato.CandidatoNombre</span>
                                    
                                    <div class="mt-auto pt-2 border-t border-gray-100 w-full flex items-center justify-center gap-2">
                                        @if (!string.IsNullOrEmpty(candidato.LogoPartidoUrl))
                                        {
                                            <img src="@candidato.LogoPartidoUrl" alt="@candidato.PartidoNombre" class="w-5 h-5 object-contain" />
                                        }
                                        <span class="text-xs text-gray-600 font-medium">@candidato.PartidoNombre</span>
                                    </div>
                                    
                                    <div class="absolute top-3 right-3 w-5 h-5 rounded-full border-2 border-gray-300 bg-white peer-checked:border-elec-600 peer-checked:bg-elec-600 flex items-center justify-center transition-colors">
                                        <svg class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Barra inferior flotante de confirmación -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] p-4 z-50 transform transition-transform duration-300 translate-y-full" id="confirmBar">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 text-gray-700">
                <span class="text-2xl">✅</span>
                <div>
                    <p class="font-bold text-gray-900">Has completado tu selección</p>
                    <p class="text-sm">Revisa tu boleta y haz clic en continuar cuando estés listo.</p>
                </div>
            </div>
            <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-elec-600 text-white font-bold rounded-xl hover:bg-elec-900 transition-colors shadow-md">
                Revisar y Continuar ➡️
            </button>
        </div>
    </div>
    
    <!-- Botón alternativo al final de la página (para móviles o si la barra flotante no se ve bien) -->
    <div class="text-center mt-8 pb-24">
        <button type="button" id="btnSiguienteAlternativo" disabled class="px-8 py-4 bg-gray-300 text-gray-500 font-bold rounded-xl cursor-not-allowed transition-colors w-full sm:w-auto">
            Completa la selección para continuar
        </button>
    </div>

</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            actualizarProgreso();
        });

        function actualizarProgreso() {
            const contenedores = document.querySelectorAll('.puesto-container');
            let seleccionados = 0;
            const total = contenedores.length;

            contenedores.forEach(contenedor => {
                const radios = contenedor.querySelectorAll('.candidato-radio');
                let haySeleccion = Array.from(radios).some(r => r.checked);
                
                const badge = contenedor.querySelector('.status-badge');
                const dot = contenedor.querySelector('.indicator-dot');

                if (haySeleccion) {
                    seleccionados++;
                    // Actualizar badge visualmente
                    badge.classList.remove('bg-gray-200', 'text-gray-700');
                    badge.classList.add('bg-green-100', 'text-green-800');
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500 indicator-dot"></span> Seleccionado';
                } else {
                    // Revertir badge
                    badge.classList.remove('bg-green-100', 'text-green-800');
                    badge.classList.add('bg-gray-200', 'text-gray-700');
                    badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-gray-400 indicator-dot"></span> Pendiente';
                }
            });

            // Actualizar contador
            document.getElementById('puestosSeleccionados').textContent = seleccionados;

            // Mostrar/ocultar botones de confirmación
            const confirmBar = document.getElementById('confirmBar');
            const btnSiguienteAlternativo = document.getElementById('btnSiguienteAlternativo');

            if (seleccionados === total) {
                confirmBar.classList.remove('translate-y-full');
                
                btnSiguienteAlternativo.disabled = false;
                btnSiguienteAlternativo.classList.remove('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');
                btnSiguienteAlternativo.classList.add('bg-elec-600', 'text-white', 'hover:bg-elec-900', 'shadow-md');
                btnSiguienteAlternativo.textContent = 'Revisar y Continuar ➡️';
                // Hacer que el botón alternativo haga submit
                btnSiguienteAlternativo.onclick = function() {
                    document.getElementById('boletaForm').submit();
                };
            } else {
                confirmBar.classList.add('translate-y-full');
                
                btnSiguienteAlternativo.disabled = true;
                btnSiguienteAlternativo.classList.add('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');
                btnSiguienteAlternativo.classList.remove('bg-elec-600', 'text-white', 'hover:bg-elec-900', 'shadow-md');
                btnSiguienteAlternativo.textContent = 'Completa la selección para continuar';
                btnSiguienteAlternativo.onclick = null;
            }
        }
    </script>
}
