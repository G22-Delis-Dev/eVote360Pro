@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Sin Elecciones Activas";
}

<div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 max-w-2xl w-full mx-auto text-center p-10 sm:p-16">
    <div class="text-8xl mb-6">🚫</div>
    <h1 class="text-3xl font-bold text-gray-900 mb-4">No hay elecciones activas</h1>
    <p class="text-lg text-gray-600 mb-8">
        No hay ningún proceso electoral en estos momentos.
    </p>
    
    <a asp-controller="Auth" asp-action="Login" class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium text-elec-900 bg-elec-100 rounded-lg hover:bg-elec-200 transition-colors">
        Acceso a Dirigentes y Administradores
    </a>
</div>
