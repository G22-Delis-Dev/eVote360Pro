@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Sin Elecciones";
}

<div class="max-w-2xl mx-auto pt-20 pb-20 text-center">
    <div class="w-32 h-32 mx-auto mb-8 bg-gray-100 rounded-full flex items-center justify-center text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    </div>
    
    <h1 class="text-3xl font-bold text-gray-900 mb-4">No hay procesos electorales activos</h1>
    
    <p class="text-lg text-gray-500 mb-8 max-w-xl mx-auto">
        En este momento, el sistema no tiene ninguna elección activa en curso. 
        Te invitamos a volver más adelante o revisar el calendario electoral emitido por las autoridades correspondientes.
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary inline-flex px-8 py-3 text-lg">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
        </svg>
        Volver al Inicio
    </a>
</div>
