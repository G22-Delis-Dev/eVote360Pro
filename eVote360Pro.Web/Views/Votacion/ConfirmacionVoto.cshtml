@model eVote360Pro.Application.ViewModels.Votacion.ConfirmacionVotoViewModel
@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Voto Exitoso";
    ViewData["PasoActivo"] = 5;
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 text-center">
        <div class="bg-green-500 p-8 sm:p-12 text-white">
            <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white text-green-500 text-5xl mb-6 shadow-lg">
                ✓
            </div>
            <h1 class="text-3xl sm:text-4xl font-bold mb-2">¡Votación Exitosa!</h1>
            <p class="text-green-100 text-lg">Tu derecho al voto ha sido ejercido correctamente.</p>
        </div>
        
        <div class="p-8 sm:p-12">
            <div class="mb-8 p-6 bg-gray-50 rounded-xl border border-gray-200">
                <p class="text-gray-900 font-medium mb-4 text-lg">@Model.MensajeExito</p>
                <div class="flex items-center justify-center gap-2 text-sm text-gray-500">
                    <span>🕒</span>
                    <span>Registrado el: <strong>@Model.FechaParticipacion.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></span>
                </div>
            </div>

            <p class="text-gray-600 mb-8">
                Gracias por participar en este proceso electoral. Puedes cerrar esta ventana de forma segura.
            </p>

            <a href="/" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-gray-700 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors shadow-sm w-full sm:w-auto">
                Volver al Inicio
            </a>
        </div>
    </div>
</div>
