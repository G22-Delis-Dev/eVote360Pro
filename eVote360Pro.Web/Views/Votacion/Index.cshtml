@model eVote360Pro.Application.ViewModels.Votacion.InicioVotacionViewModel
@{
    Layout = "_LayoutElector";
    ViewData["Title"] = "Bienvenido a la Votación";
    ViewData["PasoActivo"] = 1;
}

<div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="bg-gradient-to-r from-elec-900 to-elec-600 p-8 sm:p-12 text-center text-white relative">
        <div class="absolute top-0 right-0 p-4 opacity-20">
            <span class="text-9xl">🗳️</span>
        </div>
        
        <h1 class="text-3xl sm:text-4xl font-bold mb-4 relative z-10">¡Bienvenido a @Model.NombreEleccion!</h1>
        <p class="text-lg text-elec-100 relative z-10 max-w-2xl mx-auto">
            El sistema electrónico y seguro para ejercer tu derecho al voto desde cualquier lugar.
        </p>
    </div>
    
    <div class="p-8 sm:p-12">
        <div class="max-w-2xl mx-auto">
            <h3 class="text-xl font-bold text-gray-900 mb-6 text-center border-b border-gray-200 pb-4">Pasos para votar:</h3>
            
            <div class="space-y-6 mb-10">
                <div class="flex gap-4 items-start">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-elec-100 text-elec-600 flex items-center justify-center font-bold">1</div>
                    <div>
                        <h4 class="font-bold text-gray-900">Valida tu Identidad</h4>
                        <p class="text-gray-600 text-sm">Ingresa tu número de documento de identidad (cédula).</p>
                    </div>
                </div>
                
                <div class="flex gap-4 items-start">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-elec-100 text-elec-600 flex items-center justify-center font-bold">2</div>
                    <div>
                        <h4 class="font-bold text-gray-900">Verifica tu Correo</h4>
                        <p class="text-gray-600 text-sm">Ingresa el código de 6 dígitos que enviaremos a tu correo registrado.</p>
                    </div>
                </div>
                
                <div class="flex gap-4 items-start">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-elec-100 text-elec-600 flex items-center justify-center font-bold">3</div>
                    <div>
                        <h4 class="font-bold text-gray-900">Selecciona tus Candidatos</h4>
                        <p class="text-gray-600 text-sm">Elige un candidato por cada puesto electivo disponible en la boleta.</p>
                    </div>
                </div>

                <div class="flex gap-4 items-start">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-elec-100 text-elec-600 flex items-center justify-center font-bold">4</div>
                    <div>
                        <h4 class="font-bold text-gray-900">Confirma tu Voto</h4>
                        <p class="text-gray-600 text-sm">Revisa tu selección y emite tu voto de manera cifrada y segura.</p>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a asp-action="ValidarIdentidad" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 text-lg font-bold text-white bg-elec-600 rounded-xl hover:bg-elec-900 transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-1 duration-200">
                    Comenzar Votación ➡️
                </a>
            </div>
        </div>
    </div>
</div>
